{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "rootDir": "src",
    "outDir": "dist/server", "types": ["node"]
  },
  "include": ["src/core", "src/shared", "src/persistence", "src/provider", "src/server"]
}
