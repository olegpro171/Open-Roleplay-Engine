    if ($LASTEXITCODE -ne 0) { throw ('Native command failed ({0}): {1}' -f $LASTEXITCODE, $Executable) }
}
function Write-Utf8([string]$Path, [string]$Text) {
    [IO.File]::WriteAllText($Path, $Text, (New-Object Text.UTF8Encoding $false))
}
function Get-OreHash([string]$Path) {
    $stream = [IO.File]::OpenRead($Path)
    $sha = [Security.Cryptography.SHA256]::Create()
    try { return [BitConverter]::ToString($sha.ComputeHash($stream)).Replace('-', '').ToLowerInvariant() }
    finally { $stream.Dispose(); $sha.Dispose() }
}
function Initialize-OreHome([string]$Installation) {
    $resolved = [IO.Path]::GetFullPath($Installation)
    foreach ($name in @('', 'cache', 'logs', 'runtime', 'app', 'data', 'languages')) {
        [IO.Directory]::CreateDirectory((Join-Path $resolved $name)) | Out-Null
    }
    # A user-owned installation must not inherit broad readable ACLs. Children,
    # including SQLite snapshots, inherit this ACL rather than POSIX mode bits.
    $acl = [IO.Directory]::GetAccessControl($resolved, [Security.AccessControl.AccessControlSections]::Access)
    $sid = [Security.Principal.WindowsIdentity]::GetCurrent().User
    # Reapplying an unchanged inheritable ACL makes Windows walk every installed
    # dependency again. Repair differing permissions, preserving the same policy.
    if (!(Test-OrePrivateDirectoryAcl $acl $sid)) {
        $acl.SetAccessRuleProtection($true, $false)
        foreach ($existing in @($acl.Access)) { $acl.RemoveAccessRuleSpecific($existing) }
        $rule = New-Object Security.AccessControl.FileSystemAccessRule($sid, 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Allow')
        $acl.AddAccessRule($rule)
        [IO.Directory]::SetAccessControl($resolved, $acl)
    }
    $env:ORE_HOME = $resolved
    $env:TEMP = Join-Path $resolved 'cache'
    $env:TMP = $env:TEMP
    Remove-Item Env:NODE_OPTIONS,Env:NODE_PATH -ErrorAction SilentlyContinue
    return $resolved
}
function Initialize-OreJob {
    if ('OreJob' -as [type]) { return }
    # Built-in .NET interop only. Assign this controller before spawning any
    # tools: descendants inherit the job without a spawn/assignment race.
    Add-OreType -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class OreJob {
    [DllImport("kernel32.dll", SetLastError=true)] static extern IntPtr CreateJobObject(IntPtr a, string n);
    [DllImport("kernel32.dll", SetLastError=true)] static extern bool SetInformationJobObject(IntPtr j, int c, IntPtr p, uint s);
    [DllImport("kernel32.dll", SetLastError=true)] static extern bool AssignProcessToJobObject(IntPtr j, IntPtr p);
    [DllImport("kernel32.dll")] static extern IntPtr GetCurrentProcess();
    static IntPtr handle;
    public static void Attach() {
        handle = CreateJobObject(IntPtr.Zero, null);
        if (handle == IntPtr.Zero) throw new System.ComponentModel.Win32Exception();
        // JOBOBJECT_EXTENDED_LIMIT_INFORMATION, x64 layout; LimitFlags at 16.
        IntPtr info = Marshal.AllocHGlobal(144);
        try {
            for (int i=0;i<144;i++) Marshal.WriteByte(info,i,0);
            Marshal.WriteInt32(info,16,0x2000); // KILL_ON_JOB_CLOSE
            if (!SetInformationJobObject(handle,9,info,144) || !AssignProcessToJobObject(handle,GetCurrentProcess()))
                throw new System.ComponentModel.Win32Exception();
        } finally { Marshal.FreeHGlobal(info); }
        // Keep the sole non-inherited handle open until controller exit.
    }
}
'@
    [OreJob]::Attach()
}

function Test-OrePrivateDirectoryAcl($Acl, $Sid) {
    if (!$Acl.AreAccessRulesProtected) { return $false }
    $rules = @($Acl.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier]))
    if ($rules.Count -ne 1) { return $false }
    $rule = $rules[0]
    return !$rule.IsInherited -and $rule.IdentityReference.Value -eq $Sid.Value -and
        $rule.AccessControlType -eq [Security.AccessControl.AccessControlType]::Allow -and
        $rule.FileSystemRights -eq [Security.AccessControl.FileSystemRights]::FullControl -and
        $rule.InheritanceFlags -eq ([Security.AccessControl.InheritanceFlags]::ContainerInherit -bor [Security.AccessControl.InheritanceFlags]::ObjectInherit) -and
        $rule.PropagationFlags -eq [Security.AccessControl.PropagationFlags]::None
}
function Set-OrePrivate([string]$Path) {
    Assert-OrePath $Path $Path | Out-Null
    $acl = [IO.Directory]::GetAccessControl($Path,[Security.AccessControl.AccessControlSections]::Access)
    $sid = [Security.Principal.WindowsIdentity]::GetCurrent().User
    if (Test-OrePrivateDirectoryAcl $acl $sid) { return }
    $acl.SetAccessRuleProtection($true,$false)
    foreach ($rule in @($acl.Access)) { $acl.RemoveAccessRuleSpecific($rule) }
    $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($sid,'FullControl','ContainerInherit,ObjectInherit','None','Allow')))
    [IO.Directory]::SetAccessControl($Path,$acl)
}

function Add-OreType([string]$TypeDefinition) {
    # Framework csc uses an ANSI API for its own TEMP/TMP scratch files even
    # though CodeDOM's explicit source/output paths support Unicode. A relative
    # temp path in the private working directory avoids code-page conversion;
    # no short aliases, shared scratch directory or machine changes are needed.
    $directory = Join-Path ([IO.Path]::GetTempPath()) ('ore-types-'+[guid]::NewGuid().ToString('N'))
    [IO.Directory]::CreateDirectory($directory) | Out-Null
    $workingDirectory = [Environment]::CurrentDirectory
    $temporary = $env:TEMP
    $temporaryAlternative = $env:TMP
    $provider = $null
    $parameters = $null
    try {
        Set-OrePrivate $directory
        [Environment]::CurrentDirectory = $directory
        $env:TEMP = '.'
        $env:TMP = '.'
        $provider = New-Object Microsoft.CSharp.CSharpCodeProvider
        $parameters = New-Object CodeDom.Compiler.CompilerParameters
        $parameters.GenerateInMemory = $true
        $parameters.TempFiles = New-Object CodeDom.Compiler.TempFileCollection($directory,$false)
        $parameters.ReferencedAssemblies.Add('System.dll') | Out-Null
        $result = $provider.CompileAssemblyFromSource($parameters,$TypeDefinition)
        if ($result.Errors.HasErrors) { throw ($result.Errors | Out-String) }
        $result.CompiledAssembly | Out-Null
    } finally {
        [Environment]::CurrentDirectory = $workingDirectory
        $env:TEMP = $temporary
        $env:TMP = $temporaryAlternative
        if ($parameters) { $parameters.TempFiles.Dispose() }
        if ($provider) { $provider.Dispose() }
        [IO.Directory]::Delete($directory,$true)
    }
}
function Assert-OrePath([string]$Root, [string]$Path) {
    $rootPath = [IO.Path]::GetFullPath($Root).TrimEnd('\')
    $full = [IO.Path]::GetFullPath($Path)
    if (!$full.Equals($rootPath,[StringComparison]::OrdinalIgnoreCase) -and !$full.StartsWith($rootPath+'\',[StringComparison]::OrdinalIgnoreCase)) { throw 'Managed path escapes installation.' }
    $cursor = $full
    while ($cursor) {
        # GetAttributes also detects dangling reparse points, unlike Test-Path.
        try { $attributes = [IO.File]::GetAttributes($cursor) }
        catch [IO.FileNotFoundException] { $attributes = 0 }
        catch [IO.DirectoryNotFoundException] { $attributes = 0 }
        if ($attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Reparse point in managed path.' }
        $parent = [IO.Path]::GetDirectoryName($cursor)
        if ($parent -eq $cursor) { break }
        $cursor = $parent
    }
    return $full
}
function Assert-OreTree([string]$Root) {
    Assert-OrePath $Root $Root | Out-Null
    foreach ($entry in [IO.Directory]::EnumerateFileSystemEntries($Root)) {
        Assert-OrePath $Root $entry | Out-Null
        if ([IO.Directory]::Exists($entry)) { Assert-OreTree $entry }
    }
}
function Expand-OreZip([string]$Archive, [string]$ExpectedRoot, [string]$Destination, [switch]$LongPaths) {
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    if ($LongPaths) {
        Initialize-OreLongPaths
        [OreLongPaths]::Assert($Destination,$Destination) | Out-Null
        if ([OreLongPaths]::Exists($Destination)) { throw 'Extraction destination must be new.' }
    } else {
        Assert-OrePath $Destination $Destination | Out-Null
        if ([IO.Directory]::Exists($Destination) -or [IO.File]::Exists($Destination)) { throw 'Extraction destination must be new.' }
    }
    $zip = [IO.Compression.ZipFile]::OpenRead($Archive)
    try {
        $seen = New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
        $files = New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
        $entries = New-Object 'Collections.Generic.List[IO.Compression.ZipArchiveEntry]'
        [long]$total = 0
        foreach ($entry in $zip.Entries) {
            $name = $entry.FullName
            $directory = $name.EndsWith('/')
            $parts = $name.TrimEnd('/').Split('/')
            if ($parts.Count -lt 1 -or $parts[0] -cne $ExpectedRoot -or $name.Length -gt 240 -or $name.EndsWith('//')) { throw ('Unexpected ZIP root/path length: '+$name) }
            foreach ($part in $parts) {
                if (!$part -or $part -eq '.' -or $part -eq '..' -or $part -match '[\\:<>"|?*~\x00-\x1f]' -or $part.EndsWith('.') -or $part.EndsWith(' ') -or $part -match '^(?i:con|prn|aux|nul|conin\$|conout\$|clock\$|com[0-9\u00b9\u00b2\u00b3]|lpt[0-9\u00b9\u00b2\u00b3])(?:\.|$)') { throw 'Unsafe Windows ZIP name.' }
            }
            $kind = (($entry.ExternalAttributes -shr 16) -band 0xf000)
            if (($kind -ne 0 -and $kind -ne 0x8000 -and $kind -ne 0x4000) -or ($entry.ExternalAttributes -band 0x400) -or ($kind -eq 0x4000 -and !$directory) -or ($kind -eq 0x8000 -and $directory)) { throw 'Unsupported ZIP entry type.' }
            $key = $parts -join '/'
            if (!$seen.Add($key)) { throw 'Duplicate/case-equivalent ZIP entry.' }
            if (!$directory) { $files.Add($key) | Out-Null }
            $total += $entry.Length
            if ($total -gt 2GB -or $zip.Entries.Count -gt 100000 -or ($directory -and $entry.Length -ne 0)) { throw 'ZIP extraction bounds exceeded.' }
            $entries.Add($entry)
        }
        if (!$entries.Count) { throw 'Empty ZIP.' }
        foreach ($key in $seen) {
            $ancestor = $key
            while ($ancestor.Contains('/')) {
                $ancestor = $ancestor.Substring(0,$ancestor.LastIndexOf('/'))
                if ($files.Contains($ancestor)) { throw 'ZIP file/directory collision.' }
            }
        }
        # The complete listing has passed before the first output is created.
        if ($LongPaths) { [OreLongPaths]::CreateDirectory($Destination,$Destination) }
        else { [IO.Directory]::CreateDirectory($Destination) | Out-Null }
        foreach ($entry in $entries) {
            $relative = $entry.FullName.Substring($ExpectedRoot.Length).TrimStart('/')
            if (!$relative) { continue }
            $targetPath = $Destination.TrimEnd('\')+'\'+$relative.Replace('/','\')
            if ($LongPaths) {
                $target = [OreLongPaths]::Assert($Destination,$targetPath)
                if ($entry.FullName.EndsWith('/')) { [OreLongPaths]::CreateDirectory($Destination,$target); continue }
                [OreLongPaths]::CreateDirectory($Destination,[OreLongPaths]::Parent($target))
            } else {
                $target = Assert-OrePath $Destination $targetPath
                if ($entry.FullName.EndsWith('/')) { [IO.Directory]::CreateDirectory($target) | Out-Null; continue }
                [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($target)) | Out-Null
            }
            $inputStream = $entry.Open()
            $outputStream = if ($LongPaths) { [OreLongPaths]::CreateFile($Destination,$target) } else { [IO.File]::Open($target,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None) }
            try { $inputStream.CopyTo($outputStream) } finally { $outputStream.Dispose(); $inputStream.Dispose() }
        }
    } finally { $zip.Dispose() }
}

# Windows PowerShell 5.1 can retain legacy .NET path handling even on a current
# OS. Prepared packages use Unicode Win32 I/O with extended paths, avoiding any
# registry, host configuration or machine-policy change. Normal paths remain
# the public API so Node arguments and persisted selections are unchanged.
function Initialize-OreLongPaths {
    if ('OreLongPaths' -as [type]) { return }
    Add-OreType -TypeDefinition @'
using System;
using System.IO;
using System.Text;
using System.Collections.Generic;
using System.ComponentModel;
using System.Runtime.InteropServices;
using System.Security.Cryptography;
using Microsoft.Win32.SafeHandles;
public static class OreLongPaths {
    const uint InvalidAttributes = 0xffffffff, DirectoryFlag = 0x10, ReparseFlag = 0x400;
    [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]
    struct FindData {
        public uint Attributes;
        public System.Runtime.InteropServices.ComTypes.FILETIME Created, Accessed, Written;
        public uint SizeHigh, SizeLow, Reserved0, Reserved1;
        [MarshalAs(UnmanagedType.ByValTStr, SizeConst=260)] public string Name;
        [MarshalAs(UnmanagedType.ByValTStr, SizeConst=14)] public string AlternateName;
    }
    [DllImport("api-ms-win-core-path-l1-1-0.dll",CharSet=CharSet.Unicode,ExactSpelling=true)] static extern int PathCchCanonicalizeEx(StringBuilder output,UIntPtr length,string path,uint flags);
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true,ExactSpelling=true)] static extern uint GetFileAttributesW(string path);
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true,ExactSpelling=true)] static extern bool CreateDirectoryW(string path,IntPtr attributes);
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true,ExactSpelling=true)] static extern SafeFileHandle CreateFileW(string path,uint access,uint share,IntPtr attributes,uint mode,uint flags,IntPtr template);
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true,ExactSpelling=true)] static extern IntPtr FindFirstFileW(string path,out FindData data);
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true,ExactSpelling=true)] static extern bool FindNextFileW(IntPtr handle,out FindData data);
    [DllImport("kernel32.dll",SetLastError=true)] static extern bool FindClose(IntPtr handle);
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true,ExactSpelling=true)] static extern bool DeleteFileW(string path);
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true,ExactSpelling=true)] static extern bool RemoveDirectoryW(string path);
    static string Normalize(string path) {
        path=path.Replace('/','\\');
        if (path.StartsWith(@"\\?\UNC\",StringComparison.OrdinalIgnoreCase)) path=@"\\"+path.Substring(8);
        else if (path.StartsWith(@"\\?\",StringComparison.Ordinal)) path=path.Substring(4);
        if (path.StartsWith(@"\\.\",StringComparison.Ordinal) || !(path.StartsWith(@"\\",StringComparison.Ordinal) || (path.Length>=3 && char.IsLetter(path[0]) && path[1]==':' && path[2]=='\\'))) throw new IOException("Expected an absolute filesystem path.");
        var buffer=new StringBuilder(32768);
        // PATHCCH_ALLOW_LONG_PATHS canonicalizes beyond MAX_PATH without the
        // caller's long-path opt-in. Normalize separators before comparison.
        int result=PathCchCanonicalizeEx(buffer,new UIntPtr((uint)buffer.Capacity),path,1);
        if (result<0) Marshal.ThrowExceptionForHR(result);
        string normalized=buffer.ToString();
        if (normalized.StartsWith(@"\\?\UNC\",StringComparison.OrdinalIgnoreCase)) normalized=@"\\"+normalized.Substring(8);
        else if (normalized.StartsWith(@"\\?\",StringComparison.Ordinal)) normalized=normalized.Substring(4);
        return normalized.Length==3 && normalized[1]==':' ? normalized : normalized.TrimEnd('\\');
    }
    static string Native(string path) { return path.StartsWith(@"\\",StringComparison.Ordinal) ? @"\\?\UNC\"+path.Substring(2) : @"\\?\"+path; }
    public static string Parent(string path) {
        int index=path.LastIndexOf('\\');
        if (index<0 || index==2) return null;
        if (path.StartsWith(@"\\",StringComparison.Ordinal) && index<=path.IndexOf('\\',2)) return null;
        return path.Substring(0,index);
    }
    static uint Attributes(string path) {
        uint value=GetFileAttributesW(Native(path));
        if (value!=InvalidAttributes) return value;
        int error=Marshal.GetLastWin32Error();
        if (error==2 || error==3) return 0;
        throw new Win32Exception(error);
    }
    public static string Assert(string root,string path) {
        root=Normalize(root); path=Normalize(path);
        if (!path.Equals(root,StringComparison.OrdinalIgnoreCase) && !path.StartsWith(root+"\\",StringComparison.OrdinalIgnoreCase)) throw new IOException("Managed path escapes installation.");
        for (string cursor=path;cursor!=null;cursor=Parent(cursor)) if ((Attributes(cursor)&ReparseFlag)!=0) throw new IOException("Reparse point in managed path.");
        return path;
    }
    public static bool Exists(string path) { path=Assert(path,path); return Attributes(path)!=0; }
    public static void CreateDirectory(string root,string path) {
        path=Assert(root,path);
        uint attributes=Attributes(path);
        if ((attributes&DirectoryFlag)!=0) return;
        if (attributes!=0) throw new IOException("Managed directory collides with a file.");
        string parent=Parent(path);
        if (parent!=null && Attributes(parent)==0) CreateDirectory(root,parent);
        if (!CreateDirectoryW(Native(path),IntPtr.Zero)) throw new Win32Exception();
    }
    static FileStream Open(string root,string path,bool create) {
        path=Assert(root,path);
        var handle=CreateFileW(Native(path),create?0x40000000u:0x80000000u,create?0u:1u,IntPtr.Zero,create?1u:3u,0x80u,IntPtr.Zero);
        if (handle.IsInvalid) { int error=Marshal.GetLastWin32Error();handle.Dispose();throw new Win32Exception(error); }
        try { return new FileStream(handle,create?FileAccess.Write:FileAccess.Read,65536,false); }
        catch { handle.Dispose();throw; }
    }
    public static FileStream CreateFile(string root,string path) { return Open(root,path,true); }
    public static FileStream OpenRead(string root,string path) { return Open(root,path,false); }
    public static long Length(string root,string path) { using(var stream=Open(root,path,false)) return stream.Length; }
    public static string Hash(string root,string path) {
        using(var stream=Open(root,path,false)) using(var sha=SHA256.Create()) return BitConverter.ToString(sha.ComputeHash(stream)).Replace("-","").ToLowerInvariant();
    }
    public static bool Matches(string root,string path,long bytes,string hash) {
        using(var stream=Open(root,path,false)) {
            if (stream.Length!=bytes) return false;
            using(var sha=SHA256.Create()) return String.Equals(BitConverter.ToString(sha.ComputeHash(stream)).Replace("-",""),hash,StringComparison.OrdinalIgnoreCase);
        }
    }
    static List<FindData> Entries(string root,string directory) {
        directory=Assert(root,directory);
        FindData data;
        IntPtr handle=FindFirstFileW(Native(directory)+@"\*",out data);
        if (handle==new IntPtr(-1)) { int error=Marshal.GetLastWin32Error();if(error==2)return new List<FindData>();throw new Win32Exception(error); }
        var entries=new List<FindData>();
        try {
            do {
                if (data.Name=="." || data.Name=="..") continue;
                if ((data.Attributes&ReparseFlag)!=0) throw new IOException("Reparse point in managed path.");
                entries.Add(data);
            } while(FindNextFileW(handle,out data));
            int error=Marshal.GetLastWin32Error();
            if(error!=18) throw new Win32Exception(error);
        } finally { FindClose(handle); }
        return entries;
    }
    static void Walk(string root,string directory,List<string> files) {
        foreach(var entry in Entries(root,directory)) {
            // Entries checks the directory ancestry and every entry's reparse
            // flag. Recheck a directory before opening it. File names returned
            // by FindFirst/NextFile are single components and are never opened here.
            string path=directory.TrimEnd('\\')+"\\"+entry.Name;
            if ((entry.Attributes&DirectoryFlag)!=0) Walk(root,path,files);
            else { files.Add(path);if(files.Count>100000)throw new IOException("Managed file count exceeded."); }
        }
    }
    public static string[] Files(string root) { root=Assert(root,root);var files=new List<string>();Walk(root,root,files);return files.ToArray(); }
    public static void DeleteTree(string root) { root=Assert(root,root);DeleteDirectory(root,root); }
    static void DeleteDirectory(string root,string directory) {
        foreach(var entry in Entries(root,directory)) {
            string path=Assert(root,directory+"\\"+entry.Name);
            if((entry.Attributes&DirectoryFlag)!=0) DeleteDirectory(root,path);
            else if(!DeleteFileW(Native(path))) throw new Win32Exception();
        }
        if(!RemoveDirectoryW(Native(directory))) throw new Win32Exception();
    }
}
'@
}
function Assert-OreLongPath([string]$Root,[string]$Path) { Initialize-OreLongPaths; return [OreLongPaths]::Assert($Root,$Path) }
function Assert-OreLongTree([string]$Root) { Initialize-OreLongPaths; [OreLongPaths]::Files($Root) | Out-Null }
function Get-OreLongFiles([string]$Root) { Initialize-OreLongPaths; return [OreLongPaths]::Files($Root) }
function Get-OreLongHash([string]$Root,[string]$Path) { Initialize-OreLongPaths; return [OreLongPaths]::Hash($Root,$Path) }
function Get-OreLongLength([string]$Root,[string]$Path) { Initialize-OreLongPaths; return [OreLongPaths]::Length($Root,$Path) }
function Remove-OreLongTree([string]$Root) { Initialize-OreLongPaths; [OreLongPaths]::DeleteTree($Root) }

# Shared by the generated external/helper entries and archive builder.
function Initialize-OreCancellation {
    if ('OreCancellation' -as [type]) { return }
    Add-OreType -TypeDefinition @'
using System;
using System.Threading;
using System.Runtime.InteropServices;
public static class OreCancellation {
    static readonly CancellationTokenSource source = new CancellationTokenSource();
    delegate bool Handler(uint type);
    static readonly Handler handler = Handle;
    [DllImport("kernel32.dll",SetLastError=true)] static extern bool SetConsoleCtrlHandler(Handler callback,bool add);
    public static CancellationToken Token { get { return source.Token; } }
    public static bool IsCancelled { get { return source.IsCancellationRequested; } }
    public static void Cancel() { source.Cancel(); }
    static bool Handle(uint type) {
        if (type != 0 && type != 1) return false;
        source.Cancel();
        return true;
    }
    public static void Attach() {
        // Register after PowerShell's host handler. Console.CancelKeyPress alone
        // can be bypassed by the host's earlier native pipeline-cancel handler.
        if (!SetConsoleCtrlHandler(handler,true)) throw new System.ComponentModel.Win32Exception();
    }
}
'@
    [OreCancellation]::Attach()
}
function Test-OreCancellation {
    return ('OreCancellation' -as [type]) -and [OreCancellation]::IsCancelled
}
function Assert-OreStandaloneHome([string]$Path) {
    $full = Assert-OrePath $Path $Path
    if (![IO.Directory]::Exists($full)) {
        if ([IO.File]::Exists($full)) { throw 'folderCollision' }
        return $full
    }
    $marker = Assert-OrePath $full (Join-Path $full '.ore-installation')
    if (![IO.File]::Exists($marker) -or (New-Object IO.FileInfo $marker).Length -gt 64 -or [IO.File]::ReadAllText($marker).Trim() -cne 'ORE-installation:1') { throw 'folderCollision' }
    foreach ($name in @('cache','cache/npm','logs','app','runtime','recovery','data','languages')) {
        $target = Assert-OrePath $full (Join-Path $full $name)
        if ([IO.File]::Exists($target)) { throw 'folderCollision' }
    }
    foreach ($name in @('current','working','previous','recovery/current','.env','updates-paused')) {
        $target = Assert-OrePath $full (Join-Path $full $name)
        if ([IO.Directory]::Exists($target)) { throw 'folderCollision' }
    }
    return $full
}
function Initialize-OreStandaloneHome([string]$Path) {
    $full = Assert-OreStandaloneHome $Path
    if (![IO.Directory]::Exists($full)) {
        New-Item -ItemType Directory -Path $full -ErrorAction Stop | Out-Null
        Set-OrePrivate $full
        # CreateNew prevents another first start from replacing the ownership marker.
        $stream = [IO.File]::Open((Join-Path $full '.ore-installation'),[IO.FileMode]::CreateNew)
        try { $bytes = [Text.Encoding]::ASCII.GetBytes("ORE-installation:1`n"); $stream.Write($bytes,0,$bytes.Length) } finally { $stream.Dispose() }
    } else { Set-OrePrivate $full }
    foreach ($name in @('cache','logs','app','runtime','recovery','data','languages')) { [IO.Directory]::CreateDirectory((Join-Path $full $name)) | Out-Null }
    return $full
}
function Clear-OreInjection {
    foreach ($entry in @(Get-ChildItem Env:)) {
        if ($entry.Name -match '^(NODE_.*|NPM_.*|npm_config_.*|GYP_.*|SHARP_.*|ORE_LAUNCH_.*|ORE_SNAPSHOT_.*|ORE_DATABASE_.*|ORE_WINDOWS_BUILD_EVENTS|ORE_PACKAGE_LEASE_HOME)$') { [Environment]::SetEnvironmentVariable($entry.Name,$null,'Process') }
    }
}
function Import-OreStandaloneEnvironment([string]$Path) {
    $number = 0
    foreach ($raw in [IO.File]::ReadAllLines($Path,[Text.Encoding]::UTF8)) {
        $number++
        $line = $raw.Trim()
        if (!$line -or $line.StartsWith('#')) { continue }
        $script:OreEnvLine = $number
        if ($line -cnotmatch '^([A-Za-z_][A-Za-z0-9_]*)=(.*)$') { throw 'invalidEnv' }
        $key = $Matches[1]; $value = $Matches[2]
        if ($key -match '^(?i:ore_.*|PATH|PATHEXT|COMSPEC|SYSTEMROOT|WINDIR|TEMP|TMP|PSMODULEPATH|PSHOME|__PS.*)$' -and $key -notmatch '^(?i:ORE_SKIP_UPDATE|ORE_OPEN_BROWSER|ORE_NO_PAUSE)$') { throw 'invalidEnv' }
        if ($value.Length -ge 2 -and (($value.StartsWith('"') -and $value.EndsWith('"')) -or ($value.StartsWith("'") -and $value.EndsWith("'")))) { $value = $value.Substring(1,$value.Length-2) }
        if (!(Test-Path -LiteralPath ('Env:'+$key))) {
            if ($key -ieq 'ROLEPLAY_DATABASE' -and [string]::IsNullOrWhiteSpace($value)) { throw 'invalidEnv' }
            [Environment]::SetEnvironmentVariable($key,$value,'Process')
        }
    }
}
function Get-OreSelection([string]$HomePath, [string]$Pointer = 'current') {
    $path = Assert-OrePath $HomePath (Join-Path $HomePath $Pointer)
    if (![IO.File]::Exists($path)) { return $null }
    if ((New-Object IO.FileInfo $path).Length -gt 512) { throw 'Oversized application/runtime selection.' }
    $lines = [IO.File]::ReadAllLines($path,[Text.Encoding]::UTF8)
    if ($lines.Count -ne 2 -or $lines[0] -cnotmatch '^(release|dev)-[a-z0-9-]+$' -or $lines[1] -cnotmatch '^node-v[0-9.]+-win32-x64$') { throw 'Invalid application/runtime selection.' }
    $application = Assert-OrePath $HomePath (Join-Path $HomePath ('app/'+$lines[0]))
    $node = Assert-OrePath $HomePath (Join-Path $HomePath ('runtime/'+$lines[1]+'/node.exe'))
    return @{Id=$lines[0]; Runtime=$lines[1]; Application=$application; Node=$node}
}
function Get-OreHttps([string]$Url, [string]$Output, [int]$Seconds = 60) {
    # HttpClient bounds the whole transfer (including headers/body); redirects
    # are followed explicitly and may only stay on the expected HTTPS hosts.
    Add-Type -AssemblyName System.Net.Http
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $handler = New-Object Net.Http.HttpClientHandler
    $handler.AllowAutoRedirect = $false
    $client = New-Object Net.Http.HttpClient $handler
    $client.Timeout = [TimeSpan]::FromSeconds($Seconds)
    $client.DefaultRequestHeaders.UserAgent.ParseAdd('ORE-launcher/1')
    $cancel = if ('OreCancellation' -as [type]) { [Threading.CancellationTokenSource]::CreateLinkedTokenSource([OreCancellation]::Token) } else { New-Object Threading.CancellationTokenSource }
    if ($script:OreCatalogueStop) {
        $catalogueCancel = [Threading.CancellationTokenSource]::CreateLinkedTokenSource($cancel.Token,$script:OreCatalogueStop.Token)
    }
    $token = if ($catalogueCancel) { $catalogueCancel.Token } else { $cancel.Token }
    $cancel.CancelAfter([TimeSpan]::FromSeconds($Seconds))
    $response = $null
    try {
        $uri = [Uri]$Url
        for ($redirect = 0; $redirect -le 5; $redirect++) {
            if ($uri.Scheme -cne 'https' -or $uri.UserInfo -or $uri.Host -notin @('api.github.com','github.com','nodejs.org','release-assets.githubusercontent.com','objects.githubusercontent.com')) { throw 'Unapproved download redirect.' }
            $response = $client.GetAsync($uri,[Net.Http.HttpCompletionOption]::ResponseHeadersRead,$token).GetAwaiter().GetResult()
            if ([int]$response.StatusCode -in @(301,302,303,307,308)) {
                $uri = New-Object Uri $uri,$response.Headers.Location
                $response.Dispose(); $response = $null
                continue
            }
            $response.EnsureSuccessStatusCode() | Out-Null
            $limit = if ($uri.Host -eq 'api.github.com') { 1MB } else { 512MB }
            if ($response.Content.Headers.ContentLength -gt $limit) {
                throw ('Download bound exceeded for '+[IO.Path]::GetFileName($Output)+': announced '+$response.Content.Headers.ContentLength+' bytes; limit '+$limit+'.')
            }
            $inputStream = $response.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
            $outputStream = [IO.File]::Open($Output,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
            try {
                $buffer = New-Object byte[] 65536
                [long]$total = 0
                while (($count = $inputStream.ReadAsync($buffer,0,$buffer.Length,$token).GetAwaiter().GetResult()) -gt 0) {
                    $total += $count
                    if ($total -gt $limit) {
                        throw ('Download bound exceeded for '+[IO.Path]::GetFileName($Output)+': received at least '+$total+' bytes; limit '+$limit+'.')
                    }
                    $outputStream.Write($buffer,0,$count)
                }
                if ($null -ne $response.Content.Headers.ContentLength -and $total -ne $response.Content.Headers.ContentLength) { throw 'Truncated download.' }
            } finally { $outputStream.Dispose(); $inputStream.Dispose() }
            return
        }
        throw 'Redirect limit exceeded.'
    } finally { if ($response) { $response.Dispose() }; if ($catalogueCancel) { $catalogueCancel.Dispose() }; $cancel.Dispose(); $client.Dispose(); $handler.Dispose() }
}
function ConvertTo-OreArgument([string]$Value) {
    # CommandLineToArgvW quoting; paths are never evaluated as shell source.
    return '"'+[regex]::Replace([regex]::Replace($Value,'(\\*)"','$1$1\"'),'(\\+)$','$1$1')+'"'
}
function Invoke-OreProcess([string]$Executable, [string[]]$Arguments, [string]$Report, [switch]$Console, [scriptblock]$WhileRunning, [scriptblock]$OnOutputLine) {
    $start = New-Object Diagnostics.ProcessStartInfo
    $start.FileName = $Executable
    $start.Arguments = (($Arguments | ForEach-Object { ConvertTo-OreArgument $_ }) -join ' ')
    $start.UseShellExecute = $false
    $start.CreateNoWindow = !$Console
    $start.RedirectStandardOutput = !$Console -or $null -ne $OnOutputLine
    if ($OnOutputLine) { $start.StandardOutputEncoding = [Text.Encoding]::UTF8 }
    $start.RedirectStandardError = $true
    $process = New-Object Diagnostics.Process
    $process.StartInfo = $start
    $started = $false
    $nextLine = $null
    $outputs = @(); $tasks = @(); $paths = @()
    try {
        if (!$process.Start()) { throw 'Could not start owned process.' }
        $started = $true
        $streams = @($process.StandardError.BaseStream)
        if ($OnOutputLine) { $nextLine = $process.StandardOutput.ReadLineAsync() }
        elseif (!$Console) { $streams += $process.StandardOutput.BaseStream }
        foreach ($stream in $streams) {
            $path = Join-Path ([IO.Path]::GetDirectoryName($Report)) ('tool-'+[guid]::NewGuid()+'.tmp')
            $outputStream = [IO.File]::Open($path,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::Read)
            $paths += $path; $outputs += $outputStream; $tasks += $stream.CopyToAsync($outputStream)
        }
        do {
            while ($null -ne $nextLine -and $nextLine.IsCompleted) {
                $line = $nextLine.GetAwaiter().GetResult()
                if ($null -eq $line) { $nextLine = $null; break }
                & $OnOutputLine $line
                $nextLine = $process.StandardOutput.ReadLineAsync()
            }
            if (Test-OreCancellation) {
                # The foreground controller also receives Ctrl+C and reports its own shutdown.
                if ($Console -and $process.WaitForExit(5000)) { break }
                throw (New-Object OperationCanceledException 'Launcher cancelled.')
            }
            foreach ($task in $tasks) { if ($task.IsFaulted) { $task.GetAwaiter().GetResult() | Out-Null } }
            if ($WhileRunning -and !$process.HasExited) { & $WhileRunning }
        } while (!$process.WaitForExit(100))
        # A quick failure or Ctrl+C can exit between polls. Deliver the last
        # status before returning its exit code to the launcher.
        while ($null -ne $nextLine) {
            $line = $nextLine.GetAwaiter().GetResult()
            if ($null -eq $line) { break }
            & $OnOutputLine $line
            $nextLine = $process.StandardOutput.ReadLineAsync()
        }
        foreach ($task in $tasks) { $task.GetAwaiter().GetResult() | Out-Null }
        return $process.ExitCode
    } finally {
        # Never leave workers running after presenter/log/phase failure.
        if ($started -and !$process.HasExited) {
            $process.Kill(); $process.WaitForExit()
        }
        foreach ($task in $tasks) { try { $task.GetAwaiter().GetResult() | Out-Null } catch { } }
        foreach ($outputStream in $outputs) { $outputStream.Dispose() }
        foreach ($path in $paths) {
            $log = [IO.File]::Open($Report,[IO.FileMode]::Append,[IO.FileAccess]::Write,[IO.FileShare]::Read)
            $inputStream = [IO.File]::OpenRead($path)
            try { $inputStream.CopyTo($log) } finally { $inputStream.Dispose(); $log.Dispose() }
            [IO.File]::Delete($path)
        }
        $process.Dispose()
    }
}

# All package startup/recovery controllers hold this OS lease until exit.
# Its file may survive a crash; its exclusive handle cannot survive one.
function Initialize-OrePackageJobType {
    if ('OrePackageJob' -as [type]) { return }
    Add-OreType -TypeDefinition @'
using System;
using System.Diagnostics;
using System.Runtime.InteropServices;
using System.Threading;
public static class OrePackageJob {
    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)] static extern IntPtr CreateJobObject(IntPtr attributes, string name);
    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)] static extern IntPtr OpenJobObject(uint access, bool inherit, string name);
    [DllImport("kernel32.dll", SetLastError=true)] static extern bool QueryInformationJobObject(IntPtr job, int kind, IntPtr info, uint size, IntPtr returned);
    [DllImport("kernel32.dll", SetLastError=true)] static extern bool SetInformationJobObject(IntPtr job, int kind, IntPtr info, uint size);
    [DllImport("kernel32.dll", SetLastError=true)] static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);
    [DllImport("kernel32.dll")] static extern IntPtr GetCurrentProcess();
    [DllImport("kernel32.dll")] static extern bool CloseHandle(IntPtr handle);
    static IntPtr ownedJob;
    static bool IsQuiescent(string name) {
        IntPtr job = OpenJobObject(4, false, name); // JOB_OBJECT_QUERY
        if (job == IntPtr.Zero) {
            int error = Marshal.GetLastWin32Error();
            if (error == 2) return true; // No job object survives without workers.
            throw new System.ComponentModel.Win32Exception(error);
        }
        IntPtr info = Marshal.AllocHGlobal(48);
        try {
            // JOBOBJECT_BASIC_ACCOUNTING_INFORMATION: ActiveProcesses at 40.
            if (!QueryInformationJobObject(job, 1, info, 48, IntPtr.Zero)) throw new System.ComponentModel.Win32Exception();
            return Marshal.ReadInt32(info, 40) == 0;
        } finally {
            Marshal.FreeHGlobal(info);
            // Do not retain a query handle across waits: the previous owner's
            // KILL_ON_JOB_CLOSE must reach its last handle to stop its workers.
            CloseHandle(job);
        }
    }
    public static bool WaitForQuiescence(string name, int milliseconds) {
        Stopwatch clock = Stopwatch.StartNew();
        do {
            if (IsQuiescent(name)) return true;
            Thread.Sleep(25);
        } while (clock.ElapsedMilliseconds < milliseconds);
        return IsQuiescent(name);
    }
    public static void Attach(string name) {
        if (ownedJob != IntPtr.Zero) throw new InvalidOperationException("This controller already owns a package job.");
        IntPtr job = CreateJobObject(IntPtr.Zero, name);
        if (job == IntPtr.Zero) throw new System.ComponentModel.Win32Exception();
        int creationError = Marshal.GetLastWin32Error();
        if (creationError == 183) { CloseHandle(job); throw new InvalidOperationException("Package job identity collision."); }
        IntPtr info = Marshal.AllocHGlobal(144);
        bool attached = false;
        try {
            for (int i = 0; i < 144; i++) Marshal.WriteByte(info, i, 0);
            Marshal.WriteInt32(info, 16, 0x2000); // KILL_ON_JOB_CLOSE
            if (!SetInformationJobObject(job, 9, info, 144) || !AssignProcessToJobObject(job, GetCurrentProcess())) throw new System.ComponentModel.Win32Exception();
            ownedJob = job;
            attached = true;
        } finally {
            Marshal.FreeHGlobal(info);
            if (!attached) CloseHandle(job);
        }
        // Retain this sole non-inherited handle until the controller exits.
    }
}
'@
}
function Acquire-OrePackageLease([string]$HomePath) {
    $cache = Assert-OrePath $HomePath (Join-Path $HomePath 'cache')
    [IO.Directory]::CreateDirectory($cache) | Out-Null
    $path = Assert-OrePath $HomePath (Join-Path $cache 'launcher.lease')
    $script:OreFailure = 'installationLocked'
    $lease = [IO.File]::Open($path,[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None)
    $temporary = $null
    try {
        Initialize-OrePackageJobType
        $ownerPath = Assert-OrePath $HomePath (Join-Path $cache 'package-owner.json')
        if ([IO.Directory]::Exists($ownerPath)) { throw 'Invalid package ownership metadata.' }
        if ([IO.File]::Exists($ownerPath)) {
            if ((New-Object IO.FileInfo $ownerPath).Length -gt 1KB) { throw 'Oversized package ownership metadata.' }
            $previous = [IO.File]::ReadAllText($ownerPath,[Text.Encoding]::UTF8) | ConvertFrom-Json
            $properties = @($previous.PSObject.Properties.Name | Sort-Object)
            if (($properties -join ',') -cne 'job,version' -or $previous.version -ne 1 -or $previous.job -isnot [string] -or $previous.job -cnotmatch '^Global\\ORE-package-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$') { throw 'Invalid package ownership metadata.' }
            if (![OrePackageJob]::WaitForQuiescence($previous.job,5000)) { throw 'Previous package workers are still stopping.' }
        }
        $jobName = 'Global\ORE-package-'+[guid]::NewGuid().ToString()
        [OrePackageJob]::Attach($jobName)
        $temporary = Assert-OrePath $HomePath (Join-Path $cache ('package-owner-'+[guid]::NewGuid().ToString()+'.tmp'))
        $record = @{version=1;job=$jobName} | ConvertTo-Json -Compress
        [IO.File]::WriteAllText($temporary,$record,(New-Object Text.UTF8Encoding $false))
        if ([IO.File]::Exists($ownerPath)) { [IO.File]::Replace($temporary,$ownerPath,[NullString]::Value) }
        else { [IO.File]::Move($temporary,$ownerPath) }
        $temporary = $null
        return $lease
    } catch {
        $lease.Dispose()
        if ($temporary -and [IO.File]::Exists($temporary)) { [IO.File]::Delete($temporary) }
        throw
    }
}
function Get-OreWindowsBootTime {
    # A reboot proves that a legacy lock's owner and every worker have stopped.
    # Elapsed age or an absent/reused PID cannot establish that invariant.
    return (Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop).LastBootUpTime.ToUniversalTime()
}
function Assert-OreLegacyQuiescent([string]$HomePath) {
    $locks = @()
    foreach ($name in @('update.lock','build.lock','database-location.lock')) {
        $path = Assert-OrePath $HomePath (Join-Path $HomePath ('cache/'+$name))
        if ([IO.File]::Exists($path)) { throw 'Legacy lock must be a directory.' }
        if ([IO.Directory]::Exists($path)) { $locks += $path }
    }
    if (!$locks.Count) { return }
    $script:OreFailure = 'legacyRestart'
    $bootTime = Get-OreWindowsBootTime
    # Validate every lock before changing any of them. Retire only the exact
    # shapes written by the old controllers, never arbitrary directory content.
    foreach ($path in $locks) {
        if ([IO.Directory]::GetLastWriteTimeUtc($path) -ge $bootTime) { throw 'Legacy ownership cannot be disproved within the current Windows session.' }
        foreach ($entry in [IO.Directory]::EnumerateFileSystemEntries($path)) {
            Assert-OrePath $HomePath $entry | Out-Null
            if ([IO.Path]::GetFileName($path) -cne 'update.lock' -or [IO.Path]::GetFileName($entry) -cne 'owner' -or ![IO.File]::Exists($entry)) { throw 'Unrecognized legacy lock contents were preserved.' }
            $owner = [IO.File]::ReadAllText($entry)
            if ($owner -cnotmatch '^[1-9][0-9]*\r?\n[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\r?\n$') { throw 'Unrecognized legacy ownership record was preserved.' }
        }
    }
    foreach ($path in $locks) {
        $owner = Join-Path $path 'owner'
        if ([IO.File]::Exists($owner)) { [IO.File]::Delete($owner) }
        # Non-recursive deletion refuses any content added after validation.
        [IO.Directory]::Delete($path)
    }
}

# Protocol 2 release packages. Resolve one release, then pin every download to it.
function Read-OreJson([string]$Path, [long]$Limit = 1MB) {
    if ((New-Object IO.FileInfo $Path).Length -gt $Limit) { throw 'Oversized release metadata.' }
    return [IO.File]::ReadAllText($Path,[Text.Encoding]::UTF8) | ConvertFrom-Json
}
function Get-OreReleaseAsset([object]$Release, [string]$Name) {
    $assets = @($Release.assets | Where-Object { $_.name -ceq $Name })
    if ($assets.Count -ne 1 -or $assets[0].state -cne 'uploaded' -or $assets[0].browser_download_url -cne ('https://github.com/olegpro171/Open-Roleplay-Engine/releases/download/'+$Release.tag_name+'/'+$Name)) { throw 'Missing or invalid release asset.' }
    return $assets[0].browser_download_url
}
function Get-OreReleaseName($Release) {
    $name = if ($Release.name -is [string]) { ($Release.name -replace '[\p{Cc}\p{Cf}\p{Zl}\p{Zp}]',' ').Trim() }
    if (!$name -or $name.Length -gt 1024) { $name = [string]$Release.tag_name -replace '[^\w.-]','' }
    return $name
}
function Save-OreReleaseName([string]$Installation, $Release, [string]$Stage) {
    if (!$Installation -or $Release.draft -ne $false -or $Release.tag_name -cnotmatch '^build-([a-f0-9]{40})\z') { return }
    $commit = $Matches[1]
    try {
        $name = Get-OreReleaseName $Release
        if ($name.Length -gt 1024) { return }
        $path = Assert-OrePath $Installation (Join-Path $Installation ('cache/release-name-'+$commit))
        $temp = Assert-OrePath $Installation (Join-Path $Stage 'release-name.tmp')
        [IO.File]::WriteAllText($temp,$name)
        if ([IO.File]::Exists($path)) { [IO.File]::Replace($temp,$path,[NullString]::Value) }
        else { [IO.File]::Move($temp,$path) }
    } catch { Write-Verbose ('Cannot cache release title: '+$_.Exception.Message) }
}
function Test-OreLauncherAllowsUpdate([int]$LauncherVersion, [int]$MinimumVersion) {
    if ($LauncherVersion -ge $MinimumVersion) { return $true }
    Show-OreMessage 'launcherUpdateRequired' @{required=$MinimumVersion;url='https://github.com/olegpro171/Open-Roleplay-Engine/releases/latest'}
    return $false
}
function Read-OrePreparedMinimumLauncherVersion([string]$Prepared) {
    $filename = 'minimum-launcher-version'
    $path = Join-Path $Prepared $filename
    if ((New-Object IO.FileInfo $path).Length -gt 10) { throw 'Invalid prepared launcher requirement.' }
    $value = [IO.File]::ReadAllText($path)
    [int]$minimum = 0
    if ($value -cnotmatch '^(0|[1-9][0-9]*)\z' -or ![int]::TryParse($value,[ref]$minimum)) { throw 'Invalid prepared launcher requirement.' }
    $records = Read-OreJson (Join-Path $Prepared 'checksums.json') 16KB
    $match = @($records | Where-Object { $_.path -ceq $filename })
    if ($match.Count -ne 1 -or $match[0].sha256 -cne (Get-OreHash $path)) { throw 'Prepared launcher requirement differs from its inventory.' }
    return $minimum
}

function Get-OreRelease([string]$StagePath, [int]$LauncherVersion, [string]$InstalledCommit) {
    $metadata = Join-Path $StagePath 'release.json'
    Get-OreHttps 'https://api.github.com/repos/olegpro171/Open-Roleplay-Engine/releases/latest' $metadata 30
    $release = Read-OreJson $metadata
    Save-OreReleaseName $Installation $release $StagePath
    if ($InstalledCommit -and $release.tag_name -ceq ('build-'+$InstalledCommit) -and $release.draft -eq $false -and $release.prerelease -eq $false) { return }
    $descriptor = Read-OreReleaseDescriptor $StagePath $release
    if (!(Test-OreLauncherAllowsUpdate $LauncherVersion $descriptor.MinimumLauncherVersion)) { return @{Blocked=$true} }
    return $descriptor
}
function Read-OreReleaseDescriptor([string]$StagePath, $Release) {
    if ($release.draft -ne $false -or $release.prerelease -ne $false -or $release.tag_name -cnotmatch '^build-[a-f0-9]{40}$') { throw 'Invalid published release identity.' }
    $descriptorPath = Join-Path $StagePath ($release.tag_name+'.json')
    Get-OreHttps (Get-OreReleaseAsset $release 'ORE-windows-x64.json') $descriptorPath 30
    $package = Read-OreJson $descriptorPath
    if (($package.formatVersion -isnot [int] -and $package.formatVersion -isnot [long]) -or
        $package.formatVersion -notin @(1,2) -or $package.platform -cne 'win32' -or $package.arch -cne 'x64' -or $package.launcherProtocol -ne 2) {
        throw 'Unsupported Windows release package protocol/platform.'
    }
    $minimum = 0
    if ($package.formatVersion -eq 2) {
        $minimum = $package.minimumLauncherVersion
        if (($minimum -isnot [int] -and $minimum -isnot [long]) -or $minimum -lt 1 -or $minimum -gt [int]::MaxValue) {
            throw 'Invalid minimum launcher version.'
        }
    } elseif ($package.PSObject.Properties['minimumLauncherVersion']) {
        throw 'A minimum launcher version requires descriptor format 2.'
    }
    if ($package.commit -isnot [string] -or $package.commit -cnotmatch '^[a-f0-9]{40}$' -or $release.tag_name -cne ('build-'+$package.commit)) { throw 'Package commit differs from release tag.' }
    if ($package.archive -cne 'ORE-windows-x64.zip' -or $package.sha256 -isnot [string] -or $package.sha256 -cnotmatch '^[a-f0-9]{64}$') { throw 'Invalid package archive identity.' }
    $integerSize = $package.bytes -is [long] -or $package.bytes -is [int]
    if (!$integerSize -or $package.bytes -lt 1 -or $package.bytes -gt 512MB) { throw 'Package size is outside supported download bounds.' }
    return @{Commit=$package.commit; Sha256=$package.sha256; Bytes=$package.bytes; MinimumLauncherVersion=$minimum; Archive=(Get-OreReleaseAsset $release 'ORE-windows-x64.zip'); Checksum=(Get-OreReleaseAsset $release 'ORE-windows-x64.zip.sha256')}
}
function Test-OrePackageFiles([string]$Directory) {
    $files = @(Get-OreLongFiles $Directory)
    # Desktop ConvertFrom-Json emits a top-level array as one pipeline object.
    # Capture that array directly; @() would wrap it in a second array.
    $records = Read-OreJson (Join-Path $Directory 'checksums.json') 16MB
    if ($records -isnot [array] -or !$records.Count -or $records.Count -gt 100000) { throw 'Invalid package file inventory.' }
    $seen = New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($file in $records) {
        if ($file -isnot [Management.Automation.PSCustomObject]) { throw 'Invalid package file record.' }
        $integerSize = $file.bytes -is [long] -or $file.bytes -is [int]
        if ($file.path -isnot [string] -or $file.path -match '(^/|\\|:|(^|/)\.\.?(/|$))' -or $file.path -ceq 'checksums.json' -or $file.sha256 -isnot [string] -or $file.sha256 -cnotmatch '^[a-f0-9]{64}$' -or !$seen.Add($file.path) -or $file.link -or !$integerSize -or $file.bytes -lt 0) { throw 'Invalid package file record.' }
        $path = $Directory.TrimEnd('\')+'\'+$file.path.Replace('/','\')
        if (![OreLongPaths]::Matches($Directory,$path,$file.bytes,$file.sha256)) { throw 'Package file checksum mismatch.' }
    }
    if ($files.Count -ne $records.Count+1) { throw 'Unlisted package files.' }
}
function Get-OrePackageHelper([string]$HomePath, [string[]]$Pointers = @('current','recovery/current'), [hashtable]$Candidate) {
    # Protocol-1 source updaters never regain control of a package installation.
    foreach ($pointer in $Pointers) {
        $selection = if ($Candidate) { $Candidate } else { Get-OreSelection $HomePath $pointer }
        if (!$selection) { continue }
        $tools = if ($pointer -eq 'recovery/current') { Join-Path $HomePath ('recovery/'+$selection.Id) } else { Join-Path $selection.Application 'scripts/release' }
        $protocol = Assert-OrePath $HomePath (Join-Path $tools 'windows-package-protocol')
        if (![IO.File]::Exists($protocol)) { continue }
        if ((New-Object IO.FileInfo $protocol).Length -gt 16 -or [IO.File]::ReadAllText($protocol).Trim() -cne '2') { throw 'Unsupported installed package protocol.' }
        $complete = $true
        foreach ($name in @('windows-package-launcher.ps1','portable-launch.mjs','application-start.mjs','database-location.mjs','check-database.mjs','selection.mjs','application-assets.mjs','launcher-lock.mjs','launcher-messages.mjs','launcher-messages.json','windows-install-verify.mjs')) {
            $path = Assert-OrePath $HomePath (Join-Path $tools $name)
            try {
                if (![IO.File]::Exists($path) -or !(New-Object IO.FileInfo $path).Length) { $complete = $false; break }
                $readable = [IO.File]::OpenRead($path); $readable.Dispose()
            } catch [IO.IOException] { $complete = $false; break } catch [UnauthorizedAccessException] { $complete = $false; break }
        }
        if (!$complete) { continue }
        $helper = Join-Path $tools 'windows-package-launcher.ps1'
        if ((New-Object IO.FileInfo $helper).Length -gt 1MB) { continue }
        $tokens = $null; $errors = $null
        try { [Management.Automation.Language.Parser]::ParseFile($helper,[ref]$tokens,[ref]$errors) | Out-Null }
        catch [IO.IOException] { continue } catch [UnauthorizedAccessException] { continue }
        if (!$errors.Count) { return $helper }
    }
    return $null
}

function Assert-OreForwardRelease([string]$Commit, [string]$Target, [string]$Stage) {
    if ($Commit -cnotmatch '^[a-f0-9]{40}$') { throw 'Invalid installed release identity.' }
    if ($Commit -ceq $Target) { return }
    $comparePath = Join-Path $Stage 'compare.json'
    # GitHub includes the full changed-file list on page one, even with per_page=1.
    Get-OreHttps ('https://api.github.com/repos/olegpro171/Open-Roleplay-Engine/compare/'+$Commit+'...'+$Target+'?per_page=1&page=2') $comparePath 30
    $compare = Read-OreJson $comparePath
    if ($compare.status -cne 'ahead' -or $compare.base_commit.sha -cne $Commit -or $compare.merge_base_commit.sha -cne $Commit) { throw 'Release is not a proven forward continuation.' }
}
function Test-OreVersionedHelper([string]$Helper) {
    # Discovery has already validated the helper and bounded its size.
    $header = [IO.File]::ReadLines($Helper,[Text.Encoding]::UTF8) | Select-Object -First 3
    return $header -ccontains '# ORE capability: minimum-launcher-version'
}
function Expand-OreRelease([hashtable]$Release, [string]$Stage) {
    Show-OreMessage 'downloadingVersion'
    $checksum = Join-Path $stage 'package.sha256'
    Get-OreHttps $release.Checksum $checksum 30
    if ((New-Object IO.FileInfo $checksum).Length -gt 1KB -or [IO.File]::ReadAllText($checksum).Trim() -cne ($release.Sha256+'  ORE-windows-x64.zip')) { throw 'Release checksums disagree.' }
    $archive = Join-Path $stage 'package.zip'
    Get-OreHttps $release.Archive $archive 600
    $script:OreFailure = 'verificationFailed'
    if ((New-Object IO.FileInfo $archive).Length -ne $release.Bytes -or (Get-OreHash $archive) -cne $release.Sha256) { throw 'Package checksum/size mismatch.' }
    Show-OreMessage 'preparingVersion'
    $unpacked = Join-Path $stage 'payload'
    Expand-OreZip $archive ('ORE-'+$release.Commit.Substring(0,12)+'-release-win32-x64') $unpacked -LongPaths
    Test-OrePackageFiles $unpacked
    $candidate = Get-OreSelection $unpacked
    if (!$candidate) { throw 'Package selection is missing.' }
    $info = Read-OreJson (Join-Path $candidate.Application 'build-info.json')
    if ($info.commit -cne $release.Commit -or $info.platform -cne 'win32' -or $info.arch -cne 'x64' -or $info.kind -cne 'release') { throw 'Package identity differs from release.' }
    foreach ($pointer in @('current','recovery/current')) {
        if (!(Get-OrePackageHelper $unpacked $pointer)) { throw 'Package is missing a compatible startup or recovery helper.' }
    }
    return $candidate
}
function Install-OreRelease([hashtable]$Release, [string]$Stage, [string]$Installation, [switch]$Prepare) {
    $candidate = Expand-OreRelease $Release $Stage
    Publish-OreRelease $candidate $Release $Stage $Installation -Prepare:$Prepare
}
function Publish-OreRelease($Candidate, $Release, [string]$Stage, [string]$Installation, [switch]$Prepare) {
    $unpacked = Join-Path $Stage 'payload'
    $candidateTools = Join-Path $candidate.Application 'scripts/release'
    $script:OreFailure = 'activationFailed'
    $installer = Join-Path $candidateTools 'windows-package-install.mjs'
    $arguments = @($unpacked,$Installation,$release.Commit)
    if ($Prepare) { $arguments = @('--prepare') + $arguments + @([string]$release.MinimumLauncherVersion) }
    else { Show-OreMessage 'activatingVersion' }
    if ((Invoke-OreProcess $candidate.Node (@($installer) + $arguments) $script:OreReport) -ne 0) { throw 'Package preparation or activation failed.' }
}

# The foreground presenter alone moves the cursor. Redirected callers keep the
# line-oriented transcript, including the original ready URL and log messages.
function New-OreTerminal([switch]$InteractiveMenu) {
    $vt = $Host.UI.SupportsVirtualTerminal -and $env:TERM -ne 'dumb'
    if ([Console]::IsOutputRedirected -or (!$vt -and !$InteractiveMenu)) { return }
    try { if ([Console]::WindowWidth -lt 1) { return } } catch { return }
    $light = [Console]::BackgroundColor -in @('White','Gray','Yellow','Cyan','Green','Magenta')
    # ORE Dark and Light text roles, against the terminal's own background.
    $colors = if ($light) {
        @{accent='127;96;71'; muted='89;97;110'; success='57;70;71'; danger='173;53;51'}
    } else {
        @{accent='228;170;127'; muted='159;168;182'; success='142;182;152'; danger='212;124;122'}
    }
    return @{Colors=$colors; Color=($vt -and $null -eq $env:NO_COLOR); PlainConsole=!$vt; Start=-1; End=-1; Width=0;
        Title='launching'; Role='accent'; Symbol='◐'; Primary=''; Update=''; Notice=''; Log=''; Footer=''}
}

function Format-OreTerminalText([string]$Text, [string]$Role) {
    if (!$script:OreTerminal.Color) { return $Text }
    $escape = [char]27
    return "${escape}[38;2;$($script:OreTerminal.Colors[$Role])m$Text${escape}[39m"
}

function Show-OreGreeting([int]$Version) {
    $versionLine = Get-OreMessage 'launcherVersion' @{version=$Version}
    if (!$script:OreTerminal) { [Console]::WriteLine("Open Roleplay Engine  ·  $versionLine"); return }
    $mark = @('█▀▀█ █▀▀█ █▀▀','█  █ █▄▄▀ █▀▀','▀▀▀▀ ▀  ▀ ▀▀▀')
    $labels = @('Open Roleplay Engine',(Format-OreTerminalText $versionLine 'muted'),'')
    [Console]::WriteLine()
    if ([Console]::WindowWidth -lt 40) {
        foreach ($row in $mark) { [Console]::WriteLine('  '+(Format-OreTerminalText $row 'accent')) }
        [Console]::WriteLine('  '+$labels[0]); [Console]::WriteLine('  '+$labels[1])
    } else {
        for ($i=0; $i -lt $mark.Count; $i++) {
            [Console]::WriteLine('  '+(Format-OreTerminalText $mark[$i] 'accent')+'   '+$labels[$i])
        }
    }
    [Console]::WriteLine()
}

function Clear-OreTerminalPanel {
    $t = $script:OreTerminal
    if (!$t -or $t.Start -lt 0) { return }
    try {
        $width = [Console]::BufferWidth
        $start = $t.Start
        $rows = $t.End-$start
        if ($t.MenuAnchor) {
            # ReadKey does not echo. Windows keeps this cursor on the menu's
            # first cell when a resize reflows the greeting or earlier output.
            $start = [Console]::CursorTop
            if ($t.PlainConsole -and $width -ne $t.Width) {
                $reflowed = 0
                foreach ($length in $t.MenuLineWidths) { $reflowed += 1+[Math]::Floor($length/$width) }
                $rows = [Math]::Max($rows,$reflowed)
            }
        }
        # Status panels can share the console with process output. Only clear
        # one if the cursor still marks its recorded end.
        if ($t.MenuAnchor -or ($t.Width -eq $width -and $t.End -eq [Console]::CursorTop -and [Console]::CursorLeft -eq 0)) {
            [Console]::SetCursorPosition(0,$start)
            if ($t.PlainConsole) {
                $bottom = [Math]::Min([Console]::BufferHeight-1,$start+$rows-1)
                if ($bottom -ge $start) {
                    $area = [Management.Automation.Host.Rectangle]::new(0,$start,$width-1,$bottom)
                    $blank = [Management.Automation.Host.BufferCell]::new(' ',[Console]::ForegroundColor,[Console]::BackgroundColor,'Complete')
                    $Host.UI.RawUI.SetBufferContents($area,$blank)
                }
            } else { [Console]::Write(([string][char]27)+'[J') }
        }
    } catch [ArgumentOutOfRangeException] { } # Resized between measurement and write.
    $t.Start = -1
    $t.MenuAnchor = $false
}

function Get-OreTerminalLines([int]$Width) {
    $t = $script:OreTerminal
    $title = Get-OreMessage $t.Title
    $rail = Format-OreTerminalText '│' $t.Role
    $lines = @('  '+$rail+'  '+(Format-OreTerminalText ($t.Symbol+' '+$title) $t.Role))
    if ($t.Primary) { $lines += '  '+$rail+'  '+$t.Primary }
    if ($t.Notice) { $lines += ''; $lines += '  '+$t.Notice }
    if ($t.Choices) {
        $lines += ''
        for ($i=0; $i -lt $t.Choices.Count; $i++) {
            $label = $t.Choices[$i]
            if ($i -eq $t.Focus) { $lines += '  '+(Format-OreTerminalText ('› '+$label) 'accent') }
            else { $lines += '    '+$label }
        }
    }
    if ($t.Update) {
        $label = if ($t.Title -eq 'firstInstall') { 'nextLabel' } else { 'updatesLabel' }
        $label = Format-OreTerminalText (Get-OreMessage $label) 'muted'
        $lines += ''
        if ($Width -lt 52) { $lines += '  '+$label; $lines += '  '+$t.Update }
        else { $lines += '  '+$label+'   '+$t.Update }
    }
    if ($t.Log) { $lines += ''; $lines += '  '+(Get-OreMessage 'logFile' @{absolutePath=$t.Log}) }
    if ($t.Footer) {
        $lines += ''; $lines += '  '+(Format-OreTerminalText ('─' * [Math]::Max(1,[Math]::Min(58,$Width-5))) 'muted')
        $lines += '  '+(Format-OreTerminalText $t.Footer 'muted')
    }
    return $lines
}

function Write-OreTerminalPanel {
    $t = $script:OreTerminal
    $lines = @(Get-OreTerminalLines ([Console]::WindowWidth))
    Clear-OreTerminalPanel
    $t.Width = [Math]::Max(1,[Console]::BufferWidth)
    $start = [Console]::CursorTop
    $rows = 0
    $t.MenuLineWidths = foreach ($line in $lines) {
        $visible = $line -replace '\x1b\[[0-9;]+m',''
        $length = $Host.UI.RawUI.LengthInBufferCells($visible)
        $rows += 1 + [Math]::Floor($length / $t.Width)
        $length
        [Console]::WriteLine([string]$line)
    }
    $t.End = [Console]::CursorTop
    $t.Start = if ($t.End -lt [Console]::BufferHeight-1) { $start } else { [Math]::Max(0,[Math]::Min($start,$t.End-$rows)) }
    if ($t.Choices) {
        [Console]::SetCursorPosition(0,$t.Start)
        $t.MenuAnchor = $true
    }
}

function Show-OreTerminalFailure([string]$Id, [hashtable]$Parameters = @{}) {
    $t = $script:OreTerminal
    $t.Failed = $true
    $wasRunning = $t.Title -in @('running','sessionEnded')
    $t.Title = if ($wasRunning) { 'sessionEnded' } else { 'launchStopped' }
    $t.Role = if ($Id -eq 'cancelled') { 'muted' } else { 'danger' }
    $t.Symbol = '×'
    $t.Primary = if ($wasRunning -and $Id -eq 'startupFailed') { Get-OreMessage 'sessionFailed' } else { Get-OreMessage $Id $Parameters }
    $t.Update = ''; $t.Notice = ''; $t.Footer = ''
    $t.Log = if ($Id -ne 'logFailed') { $script:OreReport }
    Write-OreTerminalPanel
}

# Only the controller's identifiers and validated ready URL enter this screen.
function Receive-OreTerminalEvent([string]$Line) {
    $t = $script:OreTerminal
    if ($t.Failed) { return }
    if ($Line.StartsWith('openUrl ')) {
        if ($t.Title -eq 'running') { return } # The browser fallback repeats the ready address.
        $address = $Line.Substring(8)
        $uri = $null
        if ($address -match '[\s\p{Cc}]' -or ![Uri]::TryCreate($address,[UriKind]::Absolute,[ref]$uri) -or
            $uri.Scheme -notin @('http','https') -or $uri.UserInfo) { return }
        $t.Title = 'running'; $t.Symbol = '●'; $t.Role = 'success'; $t.Primary = $address
        $t.Footer = Get-OreMessage 'sessionHint'
    } elseif ($Line -eq 'starting') {
        if ($t.Title -eq 'firstInstall') { $t.Update = ''; $t.Footer = '' }
        $t.Title = 'launching'; $t.Primary = Get-OreMessage 'starting'
    } elseif ($Line -eq 'browserFailed') { $t.Footer = (Get-OreMessage $Line)+'  '+(Get-OreMessage 'sessionHint') }
    elseif ($Line -in @('stopping','stopped')) {
        $t.Title = 'sessionEnded'; $t.Role = 'muted'; $t.Symbol = '○'; $t.Primary = Get-OreMessage $Line
        $t.Update = ''; $t.Notice = ''; $t.Footer = ''; $t.Log = ''
    } elseif ($Line -in @('portConflict','alreadyRunning','startupFailed','logFailed','cancelled')) {
        Show-OreTerminalFailure $Line
        return
    } else { return }
    Write-OreTerminalPanel
}

function Show-OreTerminalUpdate([string]$Id, [string]$Text, [hashtable]$Parameters) {
    $t = $script:OreTerminal
    if ($t.Title -in @('sessionEnded','launchStopped')) { return }
    if ($Id -eq 'logFile') { $t.Log = $Parameters.absolutePath }
    elseif ($Id -eq 'launcherUpdateRequired' -and $t.Title -eq 'firstInstall') { Show-OreTerminalFailure $Id $Parameters; return }
    elseif ($Id -in @('launcherUpdateRequired','preparedUpdateFailed')) { $t.Notice = $Text; $t.Update = '' }
    elseif ($Id -eq 'firstInstall') {
        $t.Title = $Id
        if ($env:ORE_OPEN_BROWSER -ne '0') { $t.Footer = Get-OreMessage 'browserWhenReady' }
    }
    elseif ($t.Title -eq 'running' -or $Id -eq 'updatesPaused') { $t.Update = $Text }
    else {
        $t.Primary = $Text
        $t.Update = if ($t.Title -eq 'firstInstall' -and $Id -eq 'downloadingVersion') { Get-OreMessage 'verifyNext' }
    }
    Write-OreTerminalPanel
}

function Get-OreMessage([string]$Id, [hashtable]$Parameters = @{}) {
    $entry = $OreMessages[$Id]
    if (!$entry) { throw 'Unknown launcher message.' }
    $value = $entry[$script:OreLanguage]
    if (!$value) { $value = $entry.en }
    $text = [regex]::Replace($value,'\{([A-Za-z]+)\}',[Text.RegularExpressions.MatchEvaluator]{
        param($match)
        $key = $match.Groups[1].Value
        if (!$Parameters.ContainsKey($key)) { throw 'Missing literal launcher parameter.' }
        return ([string]$Parameters[$key] -replace '\p{Cc}','�')
    })
    return $text
}
function Show-OreMessage([string]$Id, [hashtable]$Parameters = @{}) {
    if ($null -ne $script:OreUpdateEvents) {
        $script:OreUpdateEvents.Enqueue(@{Id=$Id; Parameters=$Parameters})
        return
    }
    $text = Get-OreMessage $Id $Parameters
    if ($script:OreTerminal) {
        Show-OreTerminalUpdate $Id $text $Parameters
    } else { [Console]::WriteLine($text) }
}

function Assert-OreWindows {
    $script:OreFailure = 'unsupportedSystem'
    if (![Environment]::Is64BitProcess -or $env:PROCESSOR_ARCHITECTURE -ne 'AMD64' -or [Environment]::OSVersion.Version.Major -lt 10 -or $PSVersionTable.PSVersion.Major -lt 5) { throw 'Requires native Windows x64 and Windows PowerShell 5.1.' }
}
function Write-OreDiagnostic([string]$Text) {
    try { [IO.File]::AppendAllText($script:OreReport,$Text+"`n",(New-Object Text.UTF8Encoding $false)) }
    catch { $script:OreFailure = 'logFailed'; throw }
}
function Open-OrePackageReport([switch]$Quiet, [string]$Prefix = 'launcher') {
    $script:OreFailure = 'logFailed'
    $reportPath = Assert-OrePath $Installation (Join-Path $Installation ('logs/'+$Prefix+'-'+[DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss')+'-'+[guid]::NewGuid()+'.txt'))
    $reportStream = [IO.File]::Open($reportPath,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::Read)
    $reportStream.Dispose()
    $script:OreReport = $reportPath
    if (!$Quiet -and !$script:OreTerminal) { Show-OreMessage 'logFile' @{absolutePath=$reportPath} }
    Write-OreDiagnostic ('Windows package protocol 2; PowerShell '+$PSVersionTable.PSVersion+'; x64; language '+$script:OreLanguage)
}
function Initialize-OrePackageEnvironment {
    Clear-OreInjection
    $env:ORE_HOME = $Installation
    $env:TEMP = Join-Path $Installation 'cache'; $env:TMP = $env:TEMP
    $script:OreFailure = 'notWritable'
    $envPath = Join-Path $Installation '.env'
    if (![IO.File]::Exists($envPath)) { $empty = [IO.File]::Open($envPath,[IO.FileMode]::CreateNew); $empty.Dispose() }
    $script:OreFailure = 'invalidEnv'
    Import-OreStandaloneEnvironment $envPath
    Clear-OreInjection
    $env:ORE_PACKAGE_LEASE_HOME = $Installation
    if ($env:ORE_SKIP_UPDATE -and $env:ORE_SKIP_UPDATE -notin @('0','1')) { throw 'Invalid skip-update setting.' }
    foreach ($key in @('ROLEPLAY_DATABASE','ROLEPLAY_TLS_CERT','ROLEPLAY_TLS_KEY')) {
        $value = [Environment]::GetEnvironmentVariable($key,'Process')
        if ($null -ne $value) {
            if ([string]::IsNullOrWhiteSpace($value)) { throw 'Empty database/TLS override.' }
            if (![IO.Path]::IsPathRooted($value)) { $value = Join-Path $Invoking $value }
            [Environment]::SetEnvironmentVariable($key,[IO.Path]::GetFullPath($value),'Process')
        }
    }
}
function New-OrePackageStage {
    $stage = Join-Path $Installation ('cache/p'+[guid]::NewGuid().ToString('N').Substring(0,8))
    [IO.Directory]::CreateDirectory($stage) | Out-Null
    return $stage
}
function Test-OreInstalled([hashtable]$Selection, [string]$Tools) {
    if (!$Selection -or ![IO.File]::Exists($Selection.Node)) { throw 'No usable installed runtime.' }
    Assert-OreLongTree $Selection.Application
    Assert-OreLongTree ([IO.Path]::GetDirectoryName($Selection.Node))
    $verify = Assert-OrePath $Installation (Join-Path $Tools 'windows-install-verify.mjs')
    if ((Invoke-OreProcess $Selection.Node @($verify,$Selection.Application) $script:OreReport) -ne 0) { throw 'Installed application verification failed.' }
}
function Show-OrePackageFailure($Failure) {
    if ($script:OreFailure -eq 'folderCollision' -and ($Failure.Exception -is [UnauthorizedAccessException] -or $Failure.Exception.InnerException -is [UnauthorizedAccessException])) { $script:OreFailure = 'notWritable' }
    if ($script:OreReport -and $script:OreFailure -ne 'logFailed') {
        try { Write-OreDiagnostic ($Failure.Exception.ToString()) } catch { $script:OreFailure = 'logFailed' }
    }
    $parameters = @{folder='ORE-internal';line=$script:OreEnvLine}
    if ($script:OreTerminal) { Show-OreTerminalFailure $script:OreFailure $parameters }
    else {
        Show-OreMessage $script:OreFailure $parameters
        if ($script:OreReport -and $script:OreFailure -ne 'logFailed') { Show-OreMessage 'assistance'; [Console]::WriteLine($script:OreReport) }
    }
}
function Remove-OrePackageStage([string]$Stage) {
    if (!$Stage) { return }
    try { Remove-OreLongTree $Stage }
    catch { if ($script:OreReport) { Write-OreDiagnostic ('Temporary cleanup: '+$_.Exception.Message) } }
}
function Wait-OreFailure([int]$Result) {
    if ($Result -ne 0 -and $env:ORE_NO_PAUSE -ne '1' -and ![Console]::IsInputRedirected) {
        try { [Console]::ReadKey($true) | Out-Null } catch { }
    }
}
$OreVersionProbe = @'
// Embedded in the external launcher so a verified older package can be checked
// before its installer changes the live selection. Run with the candidate's Node.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';

const [installation, application, schemaText] = process.argv.slice(2);
const moduleUrl = name => pathToFileURL(join(application, 'scripts/release', name)).href;
const { resolveDatabase } = await import(moduleUrl('database-location.mjs'));
const { inspectDatabase } = await import(moduleUrl('check-database.mjs'));
const { verifyStartup } = await import(moduleUrl('startup-smoke.mjs'));

try {
  const schema = Number(schemaText);
  if (!Number.isSafeInteger(schema) || schema < 1) throw new Error('Invalid candidate database schema.');
  const database = resolveDatabase(installation, process.env, false);
  if (existsSync(database.path)) inspectDatabase(application, database.path, schema, true);
} catch (error) {
  console.error(error.message);
  process.exit(2);
}
await verifyStartup(application, process.execPath, join(installation, 'cache'));

'@
# Interactive screens live in the external batch, independent of the selected app.
function New-OreChoice([string]$Label, [string]$Action, $Value = $null, [switch]$Disabled, [string[]]$Columns) {
    return @{Label=$Label; Action=$Action; Value=$Value; Disabled=$Disabled.IsPresent; Columns=$Columns}
}
function Format-OreVersionRows([array]$Choices) {
    $rows = @($Choices | Where-Object { $_.Columns })
    if (!$rows.Count) { return }
    $widths = New-Object 'int[]' $rows[0].Columns.Count
    foreach ($row in $rows) {
        for ($i=0; $i -lt $widths.Length; $i++) {
            $widths[$i] = [Math]::Max($widths[$i],$row.Columns[$i].Length)
        }
    }
    foreach ($row in $rows) {
        $last = $widths.Length-1
        while ($last -gt 0 -and !$row.Columns[$last]) { $last-- }
        $fields = for ($i=0; $i -le $last; $i++) {
            if ($i -eq $last) { $row.Columns[$i] }
            elseif ($widths[$i]) { ([string]$row.Columns[$i]).PadRight($widths[$i]) }
        }
        $row.Label = $fields -join '  ·  '
    }
}
function Read-OreMenuKey { return [Console]::ReadKey($true).Key }
function Test-OreMenuKey { return [Console]::KeyAvailable }
function Read-OreChoice([string]$Title, [string]$Primary, [array]$Choices, [string]$Notice = '', [int]$Focus = 0, [int]$AutoStartSeconds = 0, $Refresh) {
    $t = $script:OreTerminal
    $seconds = $AutoStartSeconds
    $clock = $null
    $hideCursor = $t -and ![Console]::IsOutputRedirected -and [Console]::CursorVisible
    try {
        if ($hideCursor) { [Console]::CursorVisible=$false }
        while ($true) {
            try { $count = [Math]::Max(1,[Math]::Min(9,[Console]::WindowHeight-10)) }
            catch [IO.IOException] { $count = 9 }
            $first = [Math]::Max(0,$Focus-$count+1)
            $labels = @($Choices | Select-Object -Skip $first -First $count | ForEach-Object { $_.Label })
            if ($seconds) { $labels[0] = Get-OreMessage 'menuStartCountdown' @{seconds=$seconds} }
            $hint = $Notice
            if (!$hint -and $Choices[$Focus].Action -eq 'database') { $hint = Get-OreMessage 'menuDatabaseHint' }
            if ($t) {
                $t.Title=$Title; $t.Role='accent'; $t.Symbol='◇'; $t.Primary=$Primary
                $t.Notice=$hint; $t.Log=''; $t.Update=''; $t.Footer=Get-OreMessage 'menuKeys'
                $t.Choices=$labels; $t.Focus=$Focus-$first
                Write-OreTerminalPanel
            } else {
                [Console]::WriteLine((Get-OreMessage $Title))
                if ($Primary) { [Console]::WriteLine($Primary) }
                if ($hint) { [Console]::WriteLine($hint) }
                for ($i=0; $i -lt $labels.Count; $i++) {
                    $prefix = if ($i+$first -eq $Focus) { '> ' } else { '  ' }
                    [Console]::WriteLine($prefix+$labels[$i])
                }
                [Console]::WriteLine((Get-OreMessage 'menuKeys'))
            }
            if ($seconds) {
                if (!$clock) { $clock = [Diagnostics.Stopwatch]::StartNew() }
                $shown = $seconds
                while (!(Test-OreMenuKey) -and $seconds -eq $shown) {
                    Start-Sleep -Milliseconds 40
                    $seconds = [Math]::Max(0,$AutoStartSeconds-[int][Math]::Floor($clock.Elapsed.TotalSeconds))
                }
                if (!(Test-OreMenuKey)) {
                    if (!$seconds) { return $Choices[0] }
                    continue
                }
                $seconds = 0
            }
            if ($Refresh) {
                while (!(Test-OreMenuKey)) {
                    if ($Refresh.Wait(80)) { return (New-OreChoice '' 'refresh' $Focus) }
                }
            }
            switch (Read-OreMenuKey) {
                'UpArrow'   { $Focus = ($Focus+$Choices.Count-1) % $Choices.Count }
                'DownArrow' { $Focus = ($Focus+1) % $Choices.Count }
                'Escape'    { return (New-OreChoice '' 'back') }
                'Enter'     { if (!$Choices[$Focus].Disabled) { return $Choices[$Focus] } }
            }
        }
    } finally {
        try {
            if ($t) { Clear-OreTerminalPanel; $t.Choices=$null; $t.Footer=''; $t.Notice=''; $t.Primary='' }
        } finally { if ($hideCursor) { [Console]::CursorVisible=$true } }
    }
}

function Get-OreMenuSelection([string]$Pointer = 'current') {
    try { Get-OreSelection $Installation $Pointer }
    catch { if ($script:OreReport) { Write-OreDiagnostic $_.Exception.Message } }
}
function Get-OreInstalledName([string]$Commit) {
    if ($Commit -cnotmatch '^[a-f0-9]{40}\z') { return }
    try {
        $path = Assert-OrePath $Installation (Join-Path $Installation ('cache/release-name-'+$Commit))
        if ([IO.File]::Exists($path) -and (New-Object IO.FileInfo $path).Length -le 4KB) {
            $name = ([IO.File]::ReadAllText($path) -replace '[\p{Cc}\p{Cf}\p{Zl}\p{Zp}]',' ').Trim()
            if ($name) { return $name }
        }
    } catch { if ($script:OreReport) { Write-OreDiagnostic $_.Exception.Message } }
    return $Commit.Substring(0,12)
}
function Get-OreVersionSummary {
    $current = Get-OreMenuSelection
    if (!$current) {
        if ([IO.File]::Exists((Join-Path $Installation 'current'))) { return (Get-OreMessage 'menuNoSelection') }
        return (Get-OreMessage 'menuFirst')
    }
    $version = $current.Id -replace '^release-','' -replace '^([a-f0-9]{12})-.*$','$1'
    try {
        $info = Read-OreJson (Assert-OrePath $Installation (Join-Path $current.Application 'build-info.json')) 16KB
        if ($info.commit -cmatch '^[a-f0-9]{40}\z') { $version = Get-OreInstalledName $info.commit }
    } catch { if ($script:OreReport) { Write-OreDiagnostic $_.Exception.Message } }
    $mode = if ([IO.File]::Exists((Join-Path $Installation 'updates-paused'))) { 'menuFixed' } else { 'menuLatest' }
    return ((Get-OreMessage $mode)+'  ·  '+$version)
}

function Get-OreLocalVersions {
    $directory = Assert-OrePath $Installation (Join-Path $Installation 'app')
    if (![IO.Directory]::Exists($directory)) { return }
    $prepared = Get-OreMenuSelection 'cache/prepared-update/current'
    foreach ($path in [IO.Directory]::EnumerateDirectories($directory)) {
        $id = [IO.Path]::GetFileName($path)
        if ($id -cnotmatch '^release-[a-z0-9-]+$') { continue }
        try {
            $info = Read-OreJson (Assert-OrePath $Installation (Join-Path $path 'build-info.json')) 16KB
            if ($info.kind -cne 'release' -or $info.platform -cne 'win32' -or $info.arch -cne 'x64' -or
                $info.commit -cnotmatch '^[a-f0-9]{40}$' -or $info.node -cnotmatch '^[0-9]+\.[0-9]+\.[0-9]+$') { continue }
            $runtime = 'node-v'+$info.node+'-win32-x64'
            $minimum = 0
            $file = Assert-OrePath $Installation (Join-Path $path 'scripts/release/windows-launcher-version.mjs')
            if ([IO.File]::Exists($file)) {
                if ((New-Object IO.FileInfo $file).Length -gt 16KB) { continue }
                if ([IO.File]::ReadAllText($file) -cnotmatch '(?m)^export const minimumLauncherVersion = ([0-9]+);') { continue }
                $minimum = [int]$Matches[1]
            }
            if ($prepared.Id -ceq $id) {
                $receipt = Assert-OrePath $Installation (Join-Path $Installation 'cache/prepared-update')
                Assert-OreLongTree $receipt
                $minimum = [Math]::Max($minimum,(Read-OrePreparedMinimumLauncherVersion $receipt))
            }
            @{Id=$id; Commit=$info.commit; Runtime=$runtime; Application=$path; MinimumLauncherVersion=$minimum;
              Node=(Assert-OrePath $Installation (Join-Path $Installation ('runtime/'+$runtime+'/node.exe')))}
        } catch { Write-OreDiagnostic ('Cannot list installed version '+$id+': '+$_.Exception.Message) }
    }
}

function Test-OreFixedVersion($Candidate, [string]$Stage) {
    $script:OreFailure = 'verificationFailed'
    $tools = Join-Path $Candidate.Application 'scripts/release'
    Test-OreInstalled $Candidate $tools
    $info = Read-OreJson (Join-Path $Candidate.Application 'build-info.json') 16KB
    $probe = Join-Path $Stage 'verify-fixed.mjs'
    [IO.File]::WriteAllText($probe,$OreVersionProbe,(New-Object Text.UTF8Encoding $false))
    $status = Invoke-OreProcess $Candidate.Node @($probe,$Installation,$Candidate.Application,[string]$info.schema) $script:OreReport
    if ($status -eq 2) { $script:OreFailure='menuDatabaseBlocked' }
    if ($status -ne 0) { throw 'Fixed version preflight failed.' }
}

function Set-OreFixedSelection([scriptblock]$Publish) {
    # Every package helper recognizes this pause, including after an interrupted switch.
    $marker = Assert-OrePath $Installation (Join-Path $Installation 'updates-paused')
    $alreadyPaused = [IO.File]::Exists($marker)
    $currentFile = Assert-OrePath $Installation (Join-Path $Installation 'current')
    $before = Read-OrePointerBytes $currentFile
    if (!$alreadyPaused) { [IO.File]::Open($marker,[IO.FileMode]::CreateNew).Dispose() }
    try { & $Publish }
    catch {
        if (!$alreadyPaused -and $before -ceq (Read-OrePointerBytes $currentFile)) { [IO.File]::Delete($marker) }
        throw
    }
}
function Read-OrePointerBytes([string]$Path) {
    if (![IO.File]::Exists($Path)) { return }
    # A damaged pointer can still be replaced. Every committed selection fits
    # within 512 bytes, so this sentinel also distinguishes a successful write.
    if ((New-Object IO.FileInfo $Path).Length -gt 512) { return '<oversized>' }
    return [Convert]::ToBase64String([IO.File]::ReadAllBytes($Path))
}
function Set-OreInstalledVersion($Candidate, [string]$Stage) {
    if ($Candidate.MinimumLauncherVersion -gt $LauncherVersion) { throw 'Incompatible installed version.' }
    if (!(Get-OrePackageHelper $Installation @('current') $Candidate)) { throw 'Installed helper is unavailable.' }
    Test-OreFixedVersion $Candidate $Stage
    $working = Get-OreMenuSelection 'working'
    Set-OreFixedSelection {
        if ($working -and $working.Id -cne $Candidate.Id) { Write-OreVersionSelection $working 'previous' $Stage }
        Write-OreVersionSelection $Candidate 'current' $Stage
    }
}
function Write-OreVersionSelection($Selection, [string]$Pointer, [string]$Stage) {
    $temp = Join-Path $Stage $Pointer
    # The installed Node readers use LF on every OS.
    [IO.File]::WriteAllText($temp,(@($Selection.Id,$Selection.Runtime,'') -join [char]10),(New-Object Text.UTF8Encoding $false))
    $path = Assert-OrePath $Installation (Join-Path $Installation $Pointer)
    if ([IO.File]::Exists($path)) { [IO.File]::Replace($temp,$path,[NullString]::Value) }
    else { [IO.File]::Move($temp,$path) }
}
function Get-OreReleasePage([string]$Stage, [int]$Page, [string[]]$InstalledCommits, $NamesReady) {
    $file = Join-Path $Stage 'releases.json'
    Get-OreHttps ('https://api.github.com/repos/olegpro171/Open-Roleplay-Engine/releases?per_page=5&page='+$Page) $file 12
    # Windows PowerShell preserves the outer JSON array as a single object.
    $records = Read-OreJson $file
    if ($records -isnot [array] -or $records.Count -gt 5) { throw 'Invalid release page.' }
    foreach ($release in $records) { Save-OreReleaseName $Installation $release $Stage }
    # Retained builds may predate this page. Resolve their exact tags once on entry.
    foreach ($commit in $InstalledCommits) {
        $tag = 'build-'+$commit
        if ($commit -cnotmatch '^[a-f0-9]{40}\z' -or $records.tag_name -ccontains $tag) { continue }
        try {
            $older = Join-Path $Stage ($tag+'-metadata.json')
            Get-OreHttps ('https://api.github.com/repos/olegpro171/Open-Roleplay-Engine/releases/tags/'+$tag) $older 8
            $release = Read-OreJson $older
            if ($release.tag_name -ceq $tag) { Save-OreReleaseName $Installation $release $Stage }
        } catch {
            if ($script:OreCatalogueStop.IsCancellationRequested) { throw }
            Write-OreDiagnostic ('Cannot refresh release title for '+$tag+': '+$_.Exception.Message)
        }
    }
    if ($NamesReady) { $NamesReady.Set() }
    foreach ($release in $records) {
        if ($release.draft -ne $false) { continue }
        $name = Get-OreReleaseName $release
        $date = if ($release.published_at -match '^(\d{4}-\d{2}-\d{2})T') { $Matches[1] } else { '' }
        $descriptor = $null
        $status = 'menuUnsupported'
        if ($release.tag_name -cmatch '^build-[a-f0-9]{40}$' -and $release.prerelease -eq $false) {
            try {
                $descriptor = Read-OreReleaseDescriptor $Stage $release
                $status = if ($descriptor.MinimumLauncherVersion -gt $LauncherVersion) { 'menuNewer' } else { 'menuAvailable' }
            } catch {
                if ($script:OreCatalogueStop -and $script:OreCatalogueStop.IsCancellationRequested) { throw }
                $status='menuUnverified'
                Write-OreDiagnostic $_.Exception.Message
            }
        }
        @{Name=$name; Date=$date; Status=$status; Release=$descriptor}
    }
}
function Start-OreCataloguePage([int]$Page, [string[]]$InstalledCommits) {
    $stage = New-OrePackageStage
    $stop = New-Object Threading.CancellationTokenSource
    $ready = New-Object Threading.ManualResetEventSlim
    $state = [Management.Automation.Runspaces.InitialSessionState]::CreateDefault()
    foreach ($name in @('Get-OreReleasePage','Get-OreReleaseName','Save-OreReleaseName','Assert-OrePath','Read-OreReleaseDescriptor','Get-OreReleaseAsset','Get-OreHttps','Read-OreJson','Write-OreDiagnostic')) {
        $state.Commands.Add((New-Object Management.Automation.Runspaces.SessionStateFunctionEntry($name,(Get-Command $name).Definition)))
    }
    $worker = [PowerShell]::Create($state)
    try {
        $null = $worker.AddScript({
            param($stage,$page,$stop,$report,$LauncherVersion,$Installation,$commits,$ready)
            $ErrorActionPreference='Stop'
            $script:OreCatalogueStop=$stop
            $script:OreReport=$report
            try { Get-OreReleasePage $stage $page $commits $ready } finally { $ready.Set() }
        }).AddArgument($stage).AddArgument($Page).AddArgument($stop).AddArgument($script:OreReport).AddArgument($LauncherVersion).AddArgument($Installation).AddArgument($InstalledCommits).AddArgument($ready)
        return @{Worker=$worker; Async=$worker.BeginInvoke(); Stop=$stop; Stage=$stage; NamesReady=$ready}
    } catch { $worker.Dispose(); $stop.Dispose(); $ready.Dispose(); Remove-OrePackageStage $stage; throw }
}
function Close-OreCataloguePage($Request) {
    if (!$Request -or $Request.Closed) { return }
    try {
        $Request.Stop.Cancel()
        if (!$Request.Async.IsCompleted) { $Request.Worker.Stop() }
    } finally {
        $Request.Worker.Dispose(); $Request.Stop.Dispose(); $Request.NamesReady.Dispose(); $Request.Closed=$true
        Remove-OrePackageStage $Request.Stage
    }
}
function Select-OrePublishedVersion([array]$Installed, $Request) {
    $page = 1
    while ($true) {
        $stage = New-OrePackageStage
        try {
            $script:OreFailure = 'menuCatalogueFailed'
            Show-OreMessage 'menuLoading'
            if (!$Request) { $Request = Start-OreCataloguePage $page }
            while (!$Request.Async.AsyncWaitHandle.WaitOne(80)) {
                if (![Console]::IsInputRedirected -and [Console]::KeyAvailable -and [Console]::ReadKey($true).Key -eq 'Escape') { return $false }
            }
            $rows = @($Request.Worker.EndInvoke($Request.Async))
            $options = @()
            foreach ($row in $rows) {
                $local = $Installed | Where-Object { $_.Commit -ceq $row.Release.Commit } | Select-Object -First 1
                $status = Get-OreMessage $row.Status @{version=$row.Release.MinimumLauncherVersion}
                $installedLabel = if ($local) { Get-OreMessage 'menuInstalled' }
                $options += New-OreChoice $row.Name $row.Status @{Local=$local; Release=$row.Release; Label=$row.Name} -Columns @($row.Name,$row.Date,$status,$installedLabel) -Disabled:($row.Status -ne 'menuAvailable')
            }
            Format-OreVersionRows $options
            if ($rows.Count -eq 5) { $options += New-OreChoice (Get-OreMessage 'menuNext') 'next' }
            if ($page -gt 1) { $options += New-OreChoice (Get-OreMessage 'menuPrev') 'prev' }
            $options += New-OreChoice (Get-OreMessage 'menuBack') 'back'
            $notice = if (!$rows.Count) { Get-OreMessage 'menuNoReleases' }
            $choice = Read-OreChoice 'menuGithub' (Get-OreMessage 'menuPage' @{page=$page}) $options $notice
            switch ($choice.Action) {
                'back' { return $false }
                'next' { $page++ }
                'prev' { $page-- }
                'menuAvailable' {
                    if (!(Confirm-OrePin $choice.Value.Label)) { continue }
                    Show-OreMessage 'menuVerifying'
                    if ($choice.Value.Local) { Set-OreInstalledVersion $choice.Value.Local $stage }
                    else {
                        $release = $choice.Value.Release
                        $script:OreFailure = 'downloadFailed'
                        $candidate = Expand-OreRelease $release $stage
                        Test-OreFixedVersion $candidate $stage
                        Set-OreFixedSelection { Publish-OreRelease $candidate $release $stage $Installation }
                    }
                    return $true
                }
            }
        } finally { Close-OreCataloguePage $Request; $Request=$null; Remove-OrePackageStage $stage }
    }
}
function Confirm-OrePin([string]$Name) {
    $confirm = Read-OreChoice 'menuFixed' $Name @(
        (New-OreChoice (Get-OreMessage 'menuPin') 'pin')
        (New-OreChoice (Get-OreMessage 'menuBack') 'back')
    ) (Get-OreMessage 'menuPinHint')
    return $confirm.Action -eq 'pin'
}
function Read-OreDatabaseFile {
    Add-Type -AssemblyName System.Windows.Forms
    $picker = New-Object Windows.Forms.OpenFileDialog
    try {
        $picker.Title = Get-OreMessage 'menuLocate'
        $picker.Filter = 'SQLite (*.sqlite;*.db)|*.sqlite;*.db|*.*|*.*'
        $picker.InitialDirectory = Join-Path $Installation 'data'
        if ($picker.ShowDialog() -eq 'OK') { return $picker.FileName }
    } finally { $picker.Dispose() }
}
function Select-OreRecoveryDatabase {
    $script:OreFailure = 'menuDatabaseBlocked'
    if ($env:ROLEPLAY_DATABASE) { $script:OreFailure='menuDatabaseOverride'; throw 'Database override in effect.' }
    $toolkit = Get-OreSelection $Installation 'recovery/current'
    if (!$toolkit) { throw 'Missing recovery toolkit.' }
    $directory = Assert-OrePath $Installation (Join-Path $Installation ('recovery/'+$toolkit.Id))
    Assert-OreLongTree $directory
    Assert-OreLongTree ([IO.Path]::GetDirectoryName($toolkit.Node))
    $file = Read-OreDatabaseFile
    if (!$file) { return $false }
    $argsList = @((Join-Path $directory 'recover.mjs'),$Installation,'--database','external',$file)
    if ((Invoke-OreProcess $toolkit.Node $argsList $script:OreReport) -ne 0) { throw 'Database selection failed.' }
    return $true
}

function Show-OreVersionManager {
    $notice = ''
    $installed = @(Get-OreLocalVersions | Sort-Object { $_.Id })
    $request = Start-OreCataloguePage 1 @($installed | ForEach-Object { $_.Commit } | Select-Object -Unique)
    $refresh = if ($installed.Count) { $request.NamesReady }
    $focus = 0
    try {
        while ($true) {
            $current = Get-OreMenuSelection
            $working = Get-OreMenuSelection 'working'
            $previous = Get-OreMenuSelection 'previous'
            $options = @((New-OreChoice (Get-OreMessage 'menuLatest') 'latest'))
            foreach ($entry in $installed) {
                $status = if ($entry.Id -ceq $working.Id) { 'menuLastWorking' } elseif ($entry.Id -ceq $previous.Id) { 'menuPreviousWorking' } else { 'menuInstalled' }
                $label = Get-OreInstalledName $entry.Commit
                $selected = if ($entry.Id -ceq $current.Id) { Get-OreMessage 'menuSelected' }
                $requirement = ''
                $action = 'local'
                if ($entry.MinimumLauncherVersion -gt $LauncherVersion) {
                    $requirement = Get-OreMessage 'menuNewer' @{version=$entry.MinimumLauncherVersion}; $action='blocked'
                }
                $options += New-OreChoice $label $action $entry -Columns @($label,(Get-OreMessage $status),$selected,$requirement) -Disabled:($action -eq 'blocked')
            }
            Format-OreVersionRows $options
            $options += New-OreChoice (Get-OreMessage 'menuGithub') 'github'
            if (Get-OreMenuSelection 'recovery/current') { $options += New-OreChoice (Get-OreMessage 'menuLocate') 'database' }
            $options += New-OreChoice (Get-OreMessage 'menuBack') 'back'
            $choice = Read-OreChoice 'menuManage' (Get-OreVersionSummary) $options $notice $focus 0 $refresh
            if ($choice.Action -eq 'refresh') { $refresh=$null; $focus=$choice.Value; continue }
            $focus = 0
            $notice = ''
            $stage = $null
            try {
                $script:OreFailure = 'verificationFailed'
                switch ($choice.Action) {
                    'back' { return }
                    'latest' {
                        [IO.File]::Delete((Assert-OrePath $Installation (Join-Path $Installation 'updates-paused')))
                        return
                    }
                    'local' {
                        if (Confirm-OrePin $choice.Columns[0]) {
                            $stage = New-OrePackageStage
                            Show-OreMessage 'menuVerifying'
                            Set-OreInstalledVersion $choice.Value $stage
                            return
                        }
                    }
                    'github' {
                        $refresh=$null
                        if ($request.Closed) { $request=$null }
                        if (Select-OrePublishedVersion $installed $request) { return }
                    }
                    'database' { if (Select-OreRecoveryDatabase) { return } }
                }
            } catch {
                if (Test-OreCancellation) { throw }
                Write-OreDiagnostic $_.Exception.ToString()
                $notice = (Get-OreMessage $script:OreFailure)+'  '+(Get-OreMessage 'logFile' @{absolutePath=$script:OreReport})
            } finally { Remove-OrePackageStage $stage }
        }
    } finally { Close-OreCataloguePage $request }
}

# Launcher preferences belong to the installation, across app versions.
function Test-OreShortcutPath($Path) {
    return $Path -is [string] -and $Path -match '^[a-z]:\\' -and
        $Path.Substring(2) -notmatch '[:\p{Cc}\p{Cf}]' -and [IO.Path]::GetExtension($Path) -ieq '.lnk'
}
function Get-OreBrowserSetting {
    try {
        $path = Assert-OrePath $Installation (Join-Path $Installation 'launcher-settings.json')
        if (![IO.File]::Exists($path)) { return @{Mode='default'} }
        $record = Read-OreJson $path 16KB
        if ($record.version -ne 1 -or $record.mode -cnotin @('default','shortcut','none')) { throw 'Invalid browser preference.' }
        if ($record.mode -ceq 'shortcut' -and !(Test-OreShortcutPath $record.shortcut)) { throw 'Invalid shortcut path.' }
        return @{Mode=$record.mode; Shortcut=$record.shortcut}
    } catch { return @{Mode='none'; Invalid=$true} }
}
function Save-OreBrowserSetting([string]$Mode, [string]$Shortcut) {
    $record = @{version=1; mode=$Mode}
    if ($Mode -ceq 'shortcut') {
        if (!(Test-OreShortcutPath $Shortcut) -or ![IO.File]::Exists($Shortcut)) { throw 'Choose an existing Windows shortcut.' }
        $record.shortcut = [IO.Path]::GetFullPath($Shortcut)
    } elseif ($Mode -cnotin @('default','none')) { throw 'Invalid browser preference.' }
    $path = Assert-OrePath $Installation (Join-Path $Installation 'launcher-settings.json')
    $temporary = Assert-OrePath $Installation (Join-Path $Installation ('cache/settings-'+[guid]::NewGuid()+'.tmp'))
    try {
        [IO.File]::WriteAllText($temporary,($record | ConvertTo-Json -Compress))
        if ([IO.File]::Exists($path)) { [IO.File]::Replace($temporary,$path,[NullString]::Value) }
        else { [IO.File]::Move($temporary,$path) }
    } finally { [IO.File]::Delete($temporary) }
}
function Read-OreWebAppShortcut {
    Add-Type -AssemblyName System.Windows.Forms
    $picker = New-Object Windows.Forms.OpenFileDialog
    try {
        $picker.Title = Get-OreMessage 'menuChooseShortcut'
        $picker.Filter = (Get-OreMessage 'menuShortcutFilter')+' (*.lnk)|*.lnk'
        $picker.DereferenceLinks = $false
        $picker.InitialDirectory = [Environment]::GetFolderPath('DesktopDirectory')
        if ($picker.ShowDialog() -eq 'OK') { return $picker.FileName }
    } finally { $picker.Dispose() }
}
function Show-OreLauncherSettings {
    $notice = ''
    $focus = 0
    while ($true) {
        $saved = Get-OreBrowserSetting
        $choices = foreach ($mode in @('default','shortcut','none')) {
            $label = Get-OreMessage ('menuBrowser'+$mode)
            if ($saved.Mode -ceq $mode) { $label += '  ✓' }
            New-OreChoice $label $mode
        }
        $choices += New-OreChoice (Get-OreMessage 'menuBack') 'back'
        $hint = if ($notice) { $notice } elseif ($saved.Invalid) { Get-OreMessage 'menuSettingsInvalid' }
            elseif ($env:ORE_OPEN_BROWSER -eq '0') { Get-OreMessage 'menuBrowserOverride' }
            elseif ($saved.Mode -ceq 'shortcut') { $saved.Shortcut }
        $choice = Read-OreChoice 'menuSettings' (Get-OreMessage 'menuBrowserWhenReady') $choices $hint $focus
        if ($choice.Action -eq 'back') { return }
        $focus = [array]::IndexOf($choices,$choice)
        $notice = ''
        try {
            $shortcut = if ($choice.Action -eq 'shortcut') { Read-OreWebAppShortcut }
            if ($choice.Action -eq 'shortcut' -and !$shortcut) { continue }
            Save-OreBrowserSetting $choice.Action $shortcut
        } catch { $notice = Get-OreMessage 'menuSettingsSaveFailed' }
    }
}

function Open-OreWebAppShortcut([string]$Shortcut) {
    # Explorer owns the web app. A browser started directly from this helper
    # would inherit the server's kill-on-close job.
    $shell = New-Object -ComObject Shell.Application
    $location = 0; $empty = $null; $handle = 0
    $desktop = $shell.Windows().FindWindowSW([ref]$location,[ref]$empty,8,[ref]$handle,1)
    $desktop.Document.Application.ShellExecute($Shortcut,'','','open',1)
}

# The installed helper allocates its own private receipt in this PowerShell
# process, including when running an older pinned package. Only its controller
# can announce a successful saved-data start for this launch.
function Start-OreShortcutWatcher([string]$Shortcut) {
    $directory = Assert-OrePath $Installation (Join-Path $Installation 'cache')
    $watcher = [IO.FileSystemWatcher]::new($directory,'ready-*.tmp')
    $id = 'ORE-shortcut-'+[guid]::NewGuid()
    try {
        $state = @{Shortcut=$Shortcut; Opened=$false; Open=${function:Open-OreWebAppShortcut}; Failure=(Get-OreMessage 'menuShortcutFailed')}
        $job = Register-ObjectEvent $watcher Created -SourceIdentifier $id -MessageData $state -Action {
            $state = $event.MessageData
            $receipt = $event.SourceEventArgs.FullPath
            if ($state.Opened -or $receipt -ine $env:ORE_LAUNCH_READY_RECEIPT -or ![IO.File]::Exists($receipt)) { return }
            $state.Opened = $true
            try {
                if (![IO.File]::Exists($state.Shortcut)) { throw 'Shortcut unavailable.' }
                & $state.Open $state.Shortcut
            } catch { [Console]::WriteLine($state.Failure) }
        }
        $watcher.EnableRaisingEvents = $true
        return @{Watcher=$watcher; Id=$id; Job=$job}
    } catch {
        if ($job) { Unregister-Event -SourceIdentifier $id; Remove-Job $job -Force }
        $watcher.Dispose()
        throw
    }
}
function Stop-OreShortcutWatcher($Subscription) {
    if (!$Subscription) { return }
    $Subscription.Watcher.Dispose()
    Unregister-Event -SourceIdentifier $Subscription.Id
    Remove-Job $Subscription.Job -Force
}

# Bootstrap contract 2. The normal path runs the installed controller in this
# PowerShell process. Bootstrap updates run in a short-lived worker so its
# installation lease and named job are gone before the helper acquires them.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
[Console]::OutputEncoding = New-Object Text.UTF8Encoding $false
$OutputEncoding = [Console]::OutputEncoding
$script:OreLanguage = if ($Language) { $Language } elseif ([Globalization.CultureInfo]::CurrentUICulture.Name -match '^ru(?:[-_][a-zA-Z0-9]{2,8})*$') { 'ru' } else { 'en' }
$script:OreReport = $null
$script:OreEnvLine = 1
$Invoking = [IO.Path]::GetFullPath((Get-Location).Path)
$Installation = Join-Path ([IO.Path]::GetDirectoryName($env:ORE_BOOTSTRAP_FILE)) 'ORE-internal'
$stage = $null
$lockStream = $null
$result = 1
$interactive = ![Console]::IsInputRedirected -and ![Console]::IsOutputRedirected
$script:OreTerminal = New-OreTerminal -InteractiveMenu:($interactive -and !$StartOnly -and !$InstallOnly)
try {
    if (!$InstallOnly -and !$StartOnly -and !$ManageOnly -and !$SettingsOnly) { Show-OreGreeting $LauncherVersion }
    Assert-OreWindows
    $script:OreFailure = 'folderCollision'
    $Installation = Assert-OreStandaloneHome $Installation
    if ([IO.Directory]::Exists($Installation)) { Set-OrePrivate $Installation }
    if ($ManageOnly -or $SettingsOnly) {
        $Installation = Initialize-OreStandaloneHome $Installation
        $lockStream = Acquire-OrePackageLease $Installation
        Initialize-OreCancellation
        Open-OrePackageReport -Quiet
        Assert-OreLegacyQuiescent $Installation
        Initialize-OrePackageEnvironment
        if ($SettingsOnly) { Show-OreLauncherSettings } else { Show-OreVersionManager }
        Clear-OreTerminalPanel
        exit 0
    }
    if (!$InstallOnly -and !$StartOnly -and $interactive) {
        # A worker must exit (and release its named job) before another session
        # or recovery operation can take the installation lease.
        Initialize-OreJob
        $worker = '$s=[IO.File]::ReadAllText($env:ORE_BOOTSTRAP_FILE,[Text.Encoding]::UTF8);$m=''# ORE_POWER''+''SHELL_PAYLOAD'';$i=$s.LastIndexOf($m); & ([scriptblock]::Create($s.Substring($i+$m.Length)))'
        $env:ORE_NO_PAUSE = '1'
        $worker += ' -Language '+$script:OreLanguage
        $notice = ''
        $focus = 0
        $autoStartSeconds = 3
        while ($true) {
            $choice = Read-OreChoice 'menuHome' (Get-OreVersionSummary) @(
                (New-OreChoice (Get-OreMessage 'menuStart') 'start')
                (New-OreChoice (Get-OreMessage 'menuManage') 'manage')
                (New-OreChoice (Get-OreMessage 'menuSettings') 'settings')
            ) $notice $focus $autoStartSeconds
            $autoStartSeconds = 0
            if ($choice.Action -eq 'back') { exit 0 }
            if ($choice.Action -in @('manage','settings')) {
                $screen = if ($choice.Action -eq 'settings') { ' -SettingsOnly' } else { ' -ManageOnly' }
                & (Join-Path $PSHOME 'powershell.exe') -NoProfile -ExecutionPolicy RemoteSigned -Command ($worker+$screen+'; exit $LASTEXITCODE')
                $notice = ''
                $focus = 0
            } else {
                Initialize-OreCancellation
                & (Join-Path $PSHOME 'powershell.exe') -NoProfile -ExecutionPolicy RemoteSigned -Command ($worker+' -StartOnly; exit $LASTEXITCODE')
                $status = $LASTEXITCODE
                if ($status -in @(0,130)) {
                    [Console]::WriteLine()
                    exit $status
                }
                $notice = Get-OreMessage 'menuRecoveryHint'
                $focus = 1
            }
        }
    }
    $script:OreFailure = 'helperUnavailable'
    $helper = Get-OrePackageHelper $Installation
    if (!$InstallOnly) {
        $setting = Get-OreBrowserSetting
        if ($setting.Mode -ne 'default') {
            if ($setting.Mode -ceq 'shortcut') {
                $script:OreFailure = 'invalidEnv'
                $config = Assert-OrePath $Installation (Join-Path $Installation '.env')
                if ([IO.File]::Exists($config)) { Import-OreStandaloneEnvironment $config }
                $script:OreFailure = 'helperUnavailable'
            }
            $openShortcut = $setting.Mode -ceq 'shortcut' -and $env:ORE_OPEN_BROWSER -ne '0'
            $env:ORE_OPEN_BROWSER = '0'
        }
        $versioned = $helper -and (Test-OreVersionedHelper $helper)
        if (!$versioned) {
            # Contain the activation worker if the bootstrap is terminated.
            $script:OreFailure = 'setupFailed'
            Initialize-OreJob
            $worker = '$s=[IO.File]::ReadAllText($env:ORE_BOOTSTRAP_FILE,[Text.Encoding]::UTF8);$m=''# ORE_POWER''+''SHELL_PAYLOAD'';$i=$s.LastIndexOf($m); & ([scriptblock]::Create($s.Substring($i+$m.Length))) -InstallOnly'
            & (Join-Path $PSHOME 'powershell.exe') -NoProfile -ExecutionPolicy RemoteSigned -Command ($worker+' -Language '+$script:OreLanguage)
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
            $script:OreFailure = 'helperUnavailable'
            $helper = Get-OrePackageHelper $Installation
            if (!$helper) { throw 'No compatible helper after verified activation.' }
            $versioned = Test-OreVersionedHelper $helper
        }
        $subscription = $null
        if ($openShortcut) {
            $env:ORE_LAUNCH_READY_RECEIPT = $null
            try { $subscription = Start-OreShortcutWatcher $setting.Shortcut }
            catch { [Console]::WriteLine((Get-OreMessage 'menuShortcutFailed')) }
        }
        try {
            if ($versioned) {
                & $helper -Installed -Installation $Installation -Invoking $Invoking -Language $script:OreLanguage -LauncherVersion $LauncherVersion
            } else {
                # The bootstrap owns updates until a version-aware helper is installed.
                $env:ORE_SKIP_UPDATE = '1'
                & $helper -Installed -Installation $Installation -Invoking $Invoking -Language $script:OreLanguage
            }
            $status = $LASTEXITCODE
        } finally { Stop-OreShortcutWatcher $subscription }
        exit $status
    }

    $script:OreFailure = 'folderCollision'
    $Installation = Initialize-OreStandaloneHome $Installation
    Initialize-OreCancellation
    Open-OrePackageReport
    $lockStream = Acquire-OrePackageLease $Installation
    $script:OreFailure = 'legacyRestart'
    Assert-OreLegacyQuiescent $Installation
    $script:OreFailure = 'helperUnavailable'
    $helper = Get-OrePackageHelper $Installation
    $selection = Get-OreSelection $Installation
    if ($helper -and $selection -and (Test-OreVersionedHelper $helper)) { exit 0 }
    $previous = $null
    if (!$helper -and $selection) {
        # Only the former Windows source-built standalone may cross into
        # package delivery here. A damaged package home uses explicit recovery.
        $tools = Join-Path $selection.Application 'scripts/release'
        $protocol = Assert-OrePath $Installation (Join-Path $tools 'windows-launcher-protocol')
        $packageProtocol = Assert-OrePath $Installation (Join-Path $tools 'windows-package-protocol')
        if ([IO.File]::Exists($packageProtocol) -or ![IO.File]::Exists($protocol) -or (New-Object IO.FileInfo $protocol).Length -gt 16 -or [IO.File]::ReadAllText($protocol).Trim() -cne '1') { throw 'No compatible helper for the selected installation.' }
        $previous = Read-OreJson (Assert-OrePath $Installation (Join-Path $selection.Application 'build-info.json'))
        if ($previous.kind -cne 'release' -or $previous.platform -cne 'win32' -or $previous.arch -cne 'x64') { throw 'Invalid legacy standalone release.' }
    }
    Initialize-OrePackageEnvironment
    $script:OreFailure = 'helperUnavailable'
    if ($env:ORE_SKIP_UPDATE -eq '1' -or [IO.File]::Exists((Join-Path $Installation 'updates-paused'))) {
        if ($helper -and $selection) { exit 0 } # Let the installed helper handle paused startup.
        throw 'First package activation requires updates to be enabled.'
    }
    if ($helper -and $selection) {
        $script:OreFailure = 'startupFailed'
        Test-OreInstalled $selection ([IO.Path]::GetDirectoryName($helper))
        $previous = Read-OreJson (Assert-OrePath $Installation (Join-Path $selection.Application 'build-info.json'))
    }
    $stage = New-OrePackageStage
    $script:OreFailure = 'downloadFailed'
    if (!$selection) { Show-OreMessage 'firstInstall' }
    Show-OreMessage 'checkingUpdates'
    try {
        $installedCommit = if ($helper -and $selection) { $previous.commit }
        $release = Get-OreRelease $stage $LauncherVersion $installedCommit
        if ($release -and !$release.Blocked) {
            Write-OreDiagnostic ('Resolved package release '+$release.Commit)
            if ($previous) { Assert-OreForwardRelease $previous.commit $release.Commit $stage }
            Install-OreRelease $release $stage $Installation
        }
        if (!$release.Blocked -or $selection) { $result = 0 }
    } catch {
        if (!$helper -or !$selection -or (Test-OreCancellation) -or $script:OreFailure -eq 'logFailed') { throw }
        Write-OreDiagnostic ($_.Exception.ToString())
        $committed = Get-OreSelection $Installation
        if (!$committed -or $committed.Id -cne $selection.Id -or $committed.Runtime -cne $selection.Runtime) { throw 'Activation changed selection before reporting failure; startup stopped.' }
        $result = 0 # Start the verified selection through the retained helper.
    }
} catch {
    if (Test-OreCancellation) { $script:OreFailure = 'cancelled' }
    Show-OrePackageFailure $_
} finally {
    if (Test-OreCancellation) { $result = 130 }
    try { Remove-OrePackageStage $stage } catch { $result = 74 }
    if ($lockStream) { $lockStream.Dispose() }
}
if ($result -eq 0) { Clear-OreTerminalPanel }
Wait-OreFailure $result
exit $result
